{
  "apiVersion": "policy/v1",
  "kind": "PodDisruptionBudget",
  "metadata": {
    "name": "web-server",
    "namespace": "shop"
  },
  "spec": {
    "maxUnavailable": 1,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/instance": "web-server",
        "app.kubernetes.io/name": "web-server"
      }
    }
  }
}
