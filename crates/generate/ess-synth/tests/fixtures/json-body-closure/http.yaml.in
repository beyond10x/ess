type: ess-http/1
specification:
  system: shelf
  version: v1
  # model.yaml.in gained the shorthand struct shelf.items.Tag and the field `tag` that reaches it.
  source_digest: sha256:886d4f31b977ccd67631153abcaad48f9c19bb966d88d744341643da0bcc65e8
routes:
  - command: shelf.items.AddItem
    method: post
    path: /items
    request: {encoding: json, unknown: refuse}
  - {command: shelf.items.AddStamp, method: post, path: /stamps}
  - {view: shelf.items.AllItems, method: get, path: /items}
  - {view: shelf.items.AllStamps, method: get, path: /stamps}
