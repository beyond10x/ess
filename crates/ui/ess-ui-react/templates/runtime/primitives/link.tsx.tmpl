import type { ReactNode } from "react";
import { useUiPath } from "../core";
import { Link } from "../router";
import { hrefFor } from "../../routes";
import { formatValue, safeUrl, useScope } from "../core";
import { evaluate } from "../expr";

/** A link to a page of this app, or to an external address. */
export function LinkView(props: {
  "data-ui-path": string;
  text: string;
  to?: { page: string; params?: Record<string, string> };
  href?: string;
}): ReactNode {
  const scope = useScope();
  const text = formatValue(evaluate(props.text, scope.values));
  if (props.to) {
    const params: Record<string, unknown> = {};
    for (const [name, expr] of Object.entries(props.to.params ?? {})) {
      params[name] = evaluate(expr, scope.values);
    }
    return (
      <span className="ui-link" data-ui-path={useUiPath(props["data-ui-path"])}>
        <Link to={hrefFor(props.to.page, params)}>{text}</Link>
      </span>
    );
  }
  const path = useUiPath(props["data-ui-path"]);
  // An address the browser could run (a script URL) is no link: its text is shown alone.
  const target = evaluate(props.href, scope.values);
  const href = safeUrl(target === undefined || target === null ? "#" : String(target));
  if (href === undefined) {
    return (
      <span className="ui-link" data-ui-path={path}>
        {text}
      </span>
    );
  }
  return (
    <a className="ui-link" href={href} data-ui-path={path}>
      {text}
    </a>
  );
}
