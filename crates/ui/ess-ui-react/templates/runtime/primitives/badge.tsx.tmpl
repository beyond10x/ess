import type { ReactNode } from "react";
import { useUiPath } from "../core";
import { display, formatValue, useScope } from "../core";
import { evaluate } from "../expr";
import { toneFor, type Json } from "../json";

/** A short value with a tone, fixed or looked up by value. */
export function BadgeView(props: {
  "data-ui-path": string;
  text?: string;
  field?: string;
  tone?: string;
  toneBy?: { value: string; map: Json };
  labels?: Record<string, string>;
}): ReactNode {
  const scope = useScope();
  const value = props.field !== undefined ? display(scope.values.row, props.field) : evaluate(props.text, scope.values);
  let tone = props.tone ?? "neutral";
  if (props.toneBy) {
    const picked = evaluate(props.toneBy.value, scope.values);
    const map = typeof props.toneBy.map === "string" ? evaluate(props.toneBy.map, scope.values) : props.toneBy.map;
    tone = toneFor(map, picked, tone);
  }
  // The text shown for the value; the tone above is still chosen by the raw value.
  const shownKey = ["string", "number", "boolean"].includes(typeof value) ? String(value) : undefined;
  const label =
    props.labels !== undefined && shownKey !== undefined && Object.prototype.hasOwnProperty.call(props.labels, shownKey)
      ? props.labels[shownKey]
      : undefined;
  return (
    <span className={`ui-badge ui-tone-${tone}`} data-ui-path={useUiPath(props["data-ui-path"])}>
      {label ?? formatValue(value)}
    </span>
  );
}
