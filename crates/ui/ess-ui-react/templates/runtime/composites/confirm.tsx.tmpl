import { useState, type ChangeEvent, type ReactNode } from "react";
import { useUiPath } from "../core";
import { ActionControl, runCommand, type ActionSpec } from "../actions";
//+bound
import { useRef } from "react";
import { RefusalNote, type Refusal } from "../actions";
//-bound
import { useScope } from "../core";
import { useRead } from "../data";
import { evaluate } from "../expr";
import { isObject } from "../json";

/** Confirms a command: consequences, what refers to the subject, and an optional typed check. */
export function ConfirmView(props: {
  "data-ui-path"?: string;
  body?: string;
  does?: string;
  references?: string;
  consequences?: string[];
  confirmLabel?: string;
  danger?: boolean;
  input?: { label: string; mustEqual?: string };
  alternatives?: ActionSpec[];
}): ReactNode {
  const scope = useScope();
  const [typed, setTyped] = useState("");
//+bound
  // A refused command is shown here, and the confirm stays open over it.
  const [refusal, setRefusal] = useState<Refusal | undefined>(undefined);
  const sending = useRef(false);
  const commandDone = useRef(false);
//-bound
  const params = isObject(scope.values.params) ? scope.values.params : {};
  const references = useRead(
    props.references ? { view: props.references, params: { id: "params.id" } } : undefined,
    scope.values,
    props.references !== undefined,
  );
  const expected = props.input?.mustEqual ? String(evaluate(props.input.mustEqual, scope.values)) : undefined;
  const blocked = expected !== undefined && typed !== expected;
  return (
    <div className="ui-confirm" data-ui-path={useUiPath(props["data-ui-path"])}>
      {props.body ? <p>{props.body}</p> : null}
      {props.consequences && props.consequences.length > 0 ? (
        <ul className="ui-consequences">
          {props.consequences.map((line) => (
            <li key={line}>{line}</li>
          ))}
        </ul>
      ) : null}
      {props.references && references.rows.length > 0 ? (
        <div className="ui-references">
          <p>Still referred to by:</p>
          <ul>
            {references.rows.map((row, index) => (
              <li key={index}>{isObject(row) ? String(row.label ?? row.id) : String(row)}</li>
            ))}
          </ul>
        </div>
      ) : null}
      {props.input ? (
        <label className="ui-form-field">
          <span className="ui-form-label">{props.input.label}</span>
          <input value={typed} onChange={(event: ChangeEvent<HTMLInputElement>) => setTyped(event.target.value)} />
        </label>
      ) : null}
//+bound
      <RefusalNote refusal={refusal} />
//-bound
      <div className="ui-form-actions">
        {(props.alternatives ?? []).map((action) => (
          <ActionControl key={action.name} action={action} />
        ))}
        <button type="button" className="ui-button" onClick={() => scope.close()}>
          Cancel
        </button>
        <button
          type="button"
          className={`ui-button ${props.danger === false ? "ui-tone-primary" : "ui-tone-danger"}`}
          disabled={blocked}
          onClick={() => {
            // The action that opened this confirm runs, once; the confirm's own `does` runs too
            // when it names another command, or when no action opened it.
            const opener = scope.confirmed;
//+bound
            if (sending.current) {
              return;
            }
            sending.current = true;
//-bound
            void (async () => {
              try {
//+plain
              if (props.does && props.does !== opener?.does) {
//-plain
//+bound
              if (props.does && props.does !== opener?.does && !commandDone.current) {
//-bound
                const row = scope.values.row;
//+plain
                const ok = await runCommand(scope, props.does, { ...params, ...(isObject(row) ? { id: row.id } : {}) });
//-plain
//+bound
                const ok = await runCommand(scope, props.does, { ...params, ...(isObject(row) ? { id: row.id } : {}) }, false, setRefusal);
                commandDone.current = ok;
//-bound
                if (!ok) {
                  return;
                }
              }
              if (opener) {
//+plain
                const ok = await opener.run();
//-plain
//+bound
                const ok = await opener.run(setRefusal);
//-bound
                if (!ok) {
                  return;
                }
              }
              scope.close();
              } finally {
//+bound
                sending.current = false;
//-bound
              }
            })();
          }}
        >
          {props.confirmLabel ?? "Confirm"}
        </button>
      </div>
    </div>
  );
}
