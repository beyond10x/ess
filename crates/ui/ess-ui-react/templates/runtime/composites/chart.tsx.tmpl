import type { ReactNode } from "react";
import { useUiPath } from "../core";
import { display, formatValue, useData, useScope } from "../core";
import { compareValues } from "../compare";
import type { ReadSpec } from "../data";
import { evaluate } from "../expr";

/** A chart drawn with plain elements: bars, lines (SVG) or, degraded, a table. */
export function ChartView(props: {
  "data-ui-path"?: string;
  reads?: ReadSpec;
  chart: string | { binds: string; options: string[] };
  x?: string | AxisSpec;
  series?: Array<string | AxisSpec>;
  sort?: { by: string; dir?: "asc" | "desc" };
  degrades?: Record<string, string>;
}): ReactNode {
  const scope = useScope();
  const data = useData(props.reads);
  const rows = sorted(data?.rows ?? [], props.sort);
  const kind = typeof props.chart === "string" ? props.chart : String(evaluate(props.chart.binds, scope.values) ?? props.chart.options[0]);
  const x = axis(props.x ?? "x");
  const series = (props.series ?? []).map(axis);
  const numbers = rows.flatMap((row) => series.map((one) => Number(display(row, one.field)) || 0));
  const max = Math.max(1, ...numbers);
  // An x label is cut to its slot with an ellipsis (styles.css); the title shows it in full.
  const xLabel = (row: unknown) => {
    const text = tick(row, x);
    return (
      <span className="ui-chart-x-label" title={text}>
        {text}
      </span>
    );
  };
  let body: ReactNode;
  if (kind === "table" || props.degrades?.no_charts === "table" && typeof SVGElement === "undefined") {
    body = null;
  } else if (kind === "line") {
    const width = 100;
    const step = rows.length > 1 ? width / (rows.length - 1) : width;
    body = (
      <>
        <svg viewBox={`0 0 ${width} 50`} className="ui-chart-svg" role="img" aria-label={series.map(title).join(", ")}>
          {series.map((one, index) => (
            <polyline
              key={one.field}
              className={`ui-series-${index}`}
              fill="none"
              points={rows.map((row, at) => `${at * step},${50 - ((Number(display(row, one.field)) || 0) / max) * 48}`).join(" ")}
            />
          ))}
        </svg>
        <div className="ui-chart-x">
          {rows.map((row, at) => (
            <span key={at} className="ui-chart-x-slot">
              {xLabel(row)}
            </span>
          ))}
        </div>
      </>
    );
  } else {
    body = (
      <div className="ui-bars">
        {rows.map((row, at) => (
          <div key={at} className="ui-bar-group">
            {series.map((one, index) => (
              <div
                key={one.field}
                className={`ui-bar ui-series-${index}`}
                style={{ height: `${((Number(display(row, one.field)) || 0) / max) * 100}%` }}
                title={`${title(one)}: ${tick(row, one)}`}
              />
            ))}
            {xLabel(row)}
          </div>
        ))}
      </div>
    );
  }
  return (
    <figure className={`ui-chart ui-chart-${kind}`} data-ui-path={useUiPath(props["data-ui-path"])}>
      {body ?? (
        <table className="ui-table">
          <thead>
            <tr>
              <th>{title(x)}</th>
              {series.map((one) => (
                <th key={one.field}>{title(one)}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, at) => (
              <tr key={at}>
                <td>{tick(row, x)}</td>
                {series.map((one) => (
                  <td key={one.field}>{tick(row, one)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      )}
      {body !== null && x.label !== undefined ? <div className="ui-chart-x-title">{x.label}</div> : null}
      {series.length > 0 ? (
        <figcaption>
          <ul className="ui-chart-legend">
            {series.map((one, index) => (
              <li key={one.field} className="ui-legend-item">
                <span className={`ui-swatch ui-series-${index}`} aria-hidden="true" />
                {title(one)}
              </li>
            ))}
          </ul>
        </figcaption>
      ) : null}
    </figure>
  );
}

/** A chart axis: a field, its title and the format of its ticks, as a column takes them. */
export interface AxisSpec {
  field: string;
  label?: string;
  as?: string;
  unit?: string;
}

function axis(written: string | AxisSpec): AxisSpec {
  return typeof written === "string" ? { field: written } : written;
}

/** An axis's title: its label, else its field read as words. */
function title(one: AxisSpec): string {
  return one.label ?? seriesLabel(one.field);
}

/** The value of `one` in `row`, drawn in its `as` as a column draws it. */
function tick(row: unknown, one: AxisSpec): string {
  return formatValue(display(row, one.field), one.as, undefined, { unit: one.unit });
}

/** A field's label: its name with `_` read as a space, as a column heading shows it. */
function seriesLabel(field: string): string {
  return field.replace(/_/g, " ");
}

/**
 * The rows in the order a chart's `sort` declares, after the live effects and `reads.filter`: a
 * stable sort with the collection's comparison, a number by value; without a sort, as read.
 */
function sorted<T>(rows: T[], sort?: { by: string; dir?: "asc" | "desc" }): T[] {
  if (sort === undefined) {
    return rows;
  }
  const sign = sort.dir === "desc" ? -1 : 1;
  return [...rows].sort((a, b) => compareValues(display(a, sort.by), display(b, sort.by)) * sign);
}
