import { useEffect, useRef, useState, type ChangeEvent, type KeyboardEvent, type ReactNode } from "react";
import { useUiPath } from "../core";
import { ActionControl, runCommand, type ActionSpec } from "../actions";
import { RowPath, ScopeLayer, display, rowKey, useData, useFramePath, useReport, useScope, useSectionName, type Scope } from "../core";
import type { ReadSpec } from "../data";
import { assignable, evaluate, truthy } from "../expr";
import { FieldValue, HelpNote, fieldLabel, useLabelled, type FieldSpec } from "../fields";
import { getPath, isObject, setPath, stableKey, type Json } from "../json";

/** One `item` node of a collection, by its name. */
export interface ItemSpec {
  name: string;
  node: ReactNode;
}

/** A sort a collection applies: the field and its direction. */
type SortState = { by: string; dir: "asc" | "desc" };

/** The column formats whose values sort as numbers, even when a row carries them as text. */
const NUMERIC = new Set(["number", "currency", "percent", "bytes", "duration"]);

/**
 * Rows of one read as a table, cards, a list or a tree.
 *
 * A table draws each declared column, then one column per `item` node and per toggle row action,
 * each with its heading, then an `Actions` column for the other row actions, the expand control
 * and the drag handle. It scrolls inside its frame. Cards, lists and trees draw the declared sort
 * as a sort control, the select-all of a multiple selection above the rows, and each row's
 * actions below or beside its fields. A `columnsBind` state holding a list of column names draws
 * only those columns.
 */
export function Collection(props: {
  "data-ui-path"?: string;
  reads?: ReadSpec;
  /**
   * The pager footer, on the state paths the read's page and size params bind. A `declared`
   * pager (`reads.pager`) always shows its footer; otherwise it shows when the total exceeds
   * the rows.
   */
  pager?: { page: string; size?: string; sizes?: number[]; declared?: boolean };
  columns?: FieldSpec[];
  columnsBind?: string;
  sort?: { by: string; dir?: "asc" | "desc"; allowed: string[]; mode?: "server" | "client" };
  style?: "table" | "cards" | "list" | "tree";
  selection?: "none" | "single" | "multiple";
  selectionEnabled?: string;
  selectionState?: string;
  rowActions?: ActionSpec[];
  bulkActions?: ActionSpec[];
  actions?: ActionSpec[];
  expand?: ReactNode;
  items?: ItemSpec[];
  reorder?: { does: string };
  /** The field that keys rows (`live.match`); `id` when absent. */
  rowKey?: string;
  groupBy?: string;
  groupOrder?: string[];
  showEmptyGroups?: boolean;
  degrades?: Record<string, string>;
}): ReactNode {
  const scope = useScope();
  // Rows are addressed under the collection's path, or under its frame's when it carries none.
  const frame = useFramePath();
  const container = props["data-ui-path"] ?? frame;
  const scopedContainer = useUiPath(container);
  const rowPath = (key: string) => (scopedContainer === undefined ? undefined : `${scopedContainer}/rows/${key}`);
  // A column header renders its own canonical path (`<collection>/columns/<name>`, or `…/columns/all/<name>` for
  // selectable columns), scoped as the collection is when it sits inside a row.
  const columnPath = (own: string) =>
    container !== undefined && scopedContainer !== undefined && own.startsWith(`${container}/`)
      ? `${scopedContainer}${own.slice(container.length)}`
      : own;
  const data = useData(props.reads);
  const labelled = useLabelled(props.columns ?? []);
  const section = useSectionName();
  const [heldSelection, setSelected] = useState<Json[]>([]);
  const [heldFocus, setFocused] = useState<Json | undefined>(undefined);
  const kept = new Map((data?.rows ?? []).map(row => [rowKey(row, props.rowKey), row]));
  const selected = data?.filtered ? heldSelection.map(row => kept.get(rowKey(row, props.rowKey))).filter((row): row is Json => row !== undefined) : heldSelection;
  const focused = data?.filtered && heldFocus !== undefined ? kept.get(rowKey(heldFocus, props.rowKey)) : heldFocus;
  useEffect(() => {
    if (heldSelection.length !== selected.length) setSelected(selected);
    if (heldFocus !== undefined && focused === undefined) setFocused(undefined);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [stableKey(selected), focused === undefined]);
  const [expanded, setExpanded] = useState<string | undefined>(undefined);
  const [clientSort, setClientSort] = useState<SortState | undefined>(
    props.sort ? { by: props.sort.by, dir: props.sort.dir ?? "asc" } : undefined,
  );
  // The key of the row whose drag handle is being dragged.
  const dragging = useRef<string | undefined>(undefined);
  useReport(section, { selection: props.selection === "multiple" ? selected : focused });
  const selectionState = props.selectionState;
  useEffect(() => {
    if (selectionState) {
      scope.set(selectionState, selected.map((row) => (isObject(row) && row.id !== undefined ? row.id : row)));
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectionState, stableKey(selected)]);
  const selectionOn =
    props.selection !== undefined &&
    props.selection !== "none" &&
    (props.selectionEnabled === undefined || truthy(evaluate(props.selectionEnabled, scope.values)));
  const multiple = selectionOn && props.selection === "multiple";
  const table = props.style !== "cards" && props.style !== "list" && props.style !== "tree";
  let rows: Json[] = data?.rows ?? [];
  if (clientSort && props.sort?.mode !== "server") {
    const { by, dir } = clientSort;
    const column = (props.columns ?? []).find((entry) => entry.field === by);
    const asNumber = column?.as !== undefined && NUMERIC.has(column.as);
    rows = [...rows].sort((a, b) => compareValues(display(a, by), display(b, by), asNumber) * (dir === "desc" ? -1 : 1));
  }
  // A selectable-columns state holding a list draws only the columns it names, in declared order.
  const chosen = props.columnsBind === undefined ? undefined : evaluate(props.columnsBind, scope.values);
  const columns = (props.columns ?? []).filter(
    (column) =>
      (column.visible === undefined || truthy(evaluate(column.visible, scope.values))) &&
      (!Array.isArray(chosen) || chosen.some((name) => name === column.name || name === column.field)),
  );
  const allowed = props.sort?.allowed ?? [];
  const sortableColumn = (column: FieldSpec) =>
    column.sortable === true || allowed.includes(column.field) || allowed.includes(column.name);
  const items = props.items ?? [];
  // An item shows what its node draws, which no row field names; it sorts only when `sort.allowed`
  // names it and the rows carry a field of that name, and then by that field.
  const itemSortable = (item: ItemSpec) =>
    allowed.includes(item.name) && rows.some((row) => display(row, item.name) !== undefined);
  const rowActions = props.rowActions ?? [];
  // A table draws each toggle in a column of its own; cards and lists keep it with the row's actions.
  const toggles = table ? rowActions.filter((action) => action.as === "toggle") : [];
  const buttons = table ? rowActions.filter((action) => action.as !== "toggle") : rowActions;
  const moveButtons = props.reorder !== undefined && props.degrades?.no_drag === "move_buttons";
  const actionsColumn = buttons.length > 0 || props.reorder !== undefined || props.expand !== undefined;
  const applySort = (next: SortState) => {
    setClientSort(next);
    if (props.sort?.mode === "server") {
      scope.set("state.sort", next);
    }
  };
  const toggleSort = (field: string) =>
    applySort({ by: field, dir: clientSort?.by === field && clientSort.dir === "asc" ? "desc" : "asc" });
  const sortHeading = (field: string, label: string, sortable: boolean): ReactNode =>
    sortable ? (
      <button type="button" className="ui-sort" onClick={() => toggleSort(field)}>
        {label}
        {clientSort?.by === field ? (clientSort.dir === "asc" ? " ▲" : " ▼") : ""}
      </button>
    ) : (
      label
    );
  // What a sort control offers: sortable columns, then the other fields `sort.allowed` names, then `sort.by`.
  const sortOptions: { field: string; label: string }[] = [];
  const offer = (name: string) => {
    const column = (props.columns ?? []).find((entry) => entry.field === name || entry.name === name);
    const field = column?.field ?? name;
    if (!sortOptions.some((option) => option.field === field)) {
      sortOptions.push({ field, label: column ? fieldLabel(column) : humanise(name) });
    }
  };
  columns.filter(sortableColumn).forEach((column) => offer(column.field));
  allowed.forEach(offer);
  if (props.sort) {
    offer(props.sort.by);
  }
  const isSelected = (row: Json) => selected.some((entry) => stableKey(entry) === stableKey(row));
  // A select-all over `entries`, the rows drawn below it: it adds them to the selection or takes them out.
  const selectAllOf = (entries: Json[]) =>
    multiple ? (
      <input
        type="checkbox"
        className="ui-select-all"
        aria-label="Select all rows"
        checked={entries.length > 0 && entries.every(isSelected)}
        onChange={(event: ChangeEvent<HTMLInputElement>) => {
          const on = event.target.checked;
          setSelected((list) => {
            const rest = list.filter((entry) => !entries.some((row) => stableKey(row) === stableKey(entry)));
            return on ? [...rest, ...entries] : rest;
          });
        }}
      />
    ) : null;
  const move = (row: Json, delta: number) => {
    if (props.reorder && isObject(row)) {
      void runCommand(scope, props.reorder.does, { id: row.id, delta });
    }
  };
  const groups: [string, Json[]][] = props.groupBy
    ? groupRows(rows, props.groupBy, props.groupOrder, props.showEmptyGroups)
    : [["", rows]];
  // Where each row is drawn: its group and its place in it.
  const place = new Map<string, { group: number; at: number; size: number }>();
  groups.forEach(([, entries], group) =>
    entries.forEach((row, at) => place.set(rowKey(row, props.rowKey), { group, at, size: entries.length })),
  );
  // A row moves one place within its group, never past either end. Under a client sort the drawn
  // order is not the read's, so no place in it is a place in the read: nothing moves.
  const sortedOnClient = clientSort !== undefined && props.sort?.mode !== "server";
  const canMove = (key: string, delta: number): boolean => {
    const at = place.get(key);
    return !sortedOnClient && at !== undefined && at.at + delta >= 0 && at.at + delta < at.size;
  };
  // A drop moves the dragged row one place, onto the row drawn next to it in its group: the same
  // `{id, delta}` the move buttons send.
  const dropDelta = (target: string): number | undefined => {
    const from = dragging.current;
    const source = from === undefined ? undefined : place.get(from);
    const onto = place.get(target);
    if (from === undefined || source === undefined || onto === undefined || source.group !== onto.group) {
      return undefined;
    }
    const delta = onto.at - source.at;
    return (delta === 1 || delta === -1) && canMove(from, delta) ? delta : undefined;
  };
  const renderRow = (row: Json) => {
    const key = rowKey(row, props.rowKey);
    const open = expanded === key;
    const select = selectionOn ? (
      <input
        type={props.selection === "single" ? "radio" : "checkbox"}
        checked={isSelected(row)}
        aria-label="Select row"
        onChange={(event: ChangeEvent<HTMLInputElement>) =>
          setSelected((list) =>
            props.selection === "single"
              ? [row]
              : event.target.checked
                ? [...list, row]
                : list.filter((entry) => stableKey(entry) !== stableKey(row)),
          )
        }
      />
    ) : null;
    const onFocus = () => {
      setFocused(row);
      if (props.expand) {
        setExpanded(open ? undefined : key);
      }
    };
    const expandControl = props.expand ? (
      <button
        type="button"
        className="ui-button ui-icon-button ui-expand-toggle"
        aria-expanded={open}
        aria-label={open ? "Collapse row" : "Expand row"}
        onClick={(event: { stopPropagation(): void }) => {
          event.stopPropagation();
          setFocused(row);
          setExpanded(open ? undefined : key);
        }}
      >
        {open ? "▾" : "▸"}
      </button>
    ) : null;
    const handle = props.reorder ? (
      <span
        className="ui-drag-handle"
        role="button"
        tabIndex={0}
        draggable={true}
        aria-label="Drag to reorder"
        onDragStart={(event: { dataTransfer: DataTransfer | null }) => {
          dragging.current = key;
          event.dataTransfer?.setData("text/plain", key);
        }}
        onDragEnd={() => {
          dragging.current = undefined;
        }}
        onClick={(event: { stopPropagation(): void }) => event.stopPropagation()}
        onKeyDown={(event: KeyboardEvent<HTMLElement>) => {
          if (event.key === "ArrowUp" || event.key === "ArrowDown") {
            event.preventDefault();
            const delta = event.key === "ArrowUp" ? -1 : 1;
            if (canMove(key, delta)) {
              move(row, delta);
            }
          }
        }}
      >
        ⠿
      </span>
    ) : null;
    const drop = props.reorder
      ? {
          onDragOver: (event: { preventDefault(): void }) => {
            if (dropDelta(key) !== undefined) {
              event.preventDefault();
            }
          },
          onDrop: (event: { preventDefault(): void }) => {
            event.preventDefault();
            const delta = dropDelta(key);
            const from = rows.find((entry) => rowKey(entry, props.rowKey) === dragging.current);
            dragging.current = undefined;
            if (delta !== undefined && from !== undefined) {
              move(from, delta);
            }
          },
        }
      : {};
    const actionButtons =
      buttons.length > 0 ? (
        <span className="ui-row-actions">
          {buttons.map((action) => (
            <ActionControl key={action.name} action={action} />
          ))}
        </span>
      ) : null;
    const moves = moveButtons ? (
      <span className="ui-move">
        <button type="button" className="ui-button" onClick={() => move(row, -1)}>
          ↑
        </button>
        <button type="button" className="ui-button" onClick={() => move(row, 1)}>
          ↓
        </button>
      </span>
    ) : null;
    const content = !table ? (
      <li
        key={key}
        data-ui-path={rowPath(key)}
        className={`ui-row ui-${props.style === "cards" ? "card" : "list-item"}${focused === row ? " ui-focused" : ""}`}
        onClick={onFocus}
        {...drop}
      >
        {select || handle || expandControl ? (
          <div className="ui-row-controls">
            {select}
            {handle}
            {expandControl}
          </div>
        ) : null}
        <div className="ui-row-body">
          {columns.length > 0 ? (
            <dl>
              {columns.map((column) => (
                <div key={column.name}>
                  <dt>{fieldLabel(column)}</dt>
                  <dd>
                    <FieldValue field={column} row={labelled(row)} />
                  </dd>
                </div>
              ))}
            </dl>
          ) : null}
          {items.map((item) => (
            <div key={item.name} className="ui-item">
              {item.node}
            </div>
          ))}
        </div>
        {actionButtons || moves ? (
          <div className="ui-row-tail">
            {actionButtons}
            {moves}
          </div>
        ) : null}
        {open ? <div className="ui-expand">{props.expand}</div> : null}
      </li>
    ) : (
      <>
        <tr
          key={key}
          data-ui-path={rowPath(key)}
          className={`ui-row${focused === row ? " ui-focused" : ""}`}
          onClick={onFocus}
          {...drop}
        >
          {selectionOn ? <td>{select}</td> : null}
          {columns.map((column) => (
            <td key={`column:${column.name}`}>
              <FieldValue field={column} row={labelled(row)} />
            </td>
          ))}
          {items.map((item) => (
            <td key={`item:${item.name}`} className="ui-item-cell">
              <div className="ui-item">{item.node}</div>
            </td>
          ))}
          {toggles.map((action) => (
            <td key={`toggle:${action.name}`} className="ui-toggle-cell">
              <ActionControl action={action} />
            </td>
          ))}
          {actionsColumn ? (
            <td className="ui-actions-cell">
              {expandControl}
              {handle}
              {actionButtons}
              {moves}
            </td>
          ) : null}
        </tr>
        {open ? (
          <tr className="ui-expand-row">
            <td colSpan={(selectionOn ? 1 : 0) + columns.length + items.length + toggles.length + (actionsColumn ? 1 : 0)}>
              <div className="ui-expand">{props.expand}</div>
            </td>
          </tr>
        ) : null}
      </>
    );
    return (
      <ScopeLayer key={key} values={{ row }}>
        {container === undefined ? content : (
          <RowPath container={container} rowKey={key}>
            {content}
          </RowPath>
        )}
      </ScopeLayer>
    );
  };
  const list = (entries: Json[]) =>
    !table ? (
      <ul className={`ui-collection-${props.style}`}>{entries.map(renderRow)}</ul>
    ) : (
      <div className="ui-table-frame">
        <table className="ui-table">
          <thead>
            <tr>
              {selectionOn ? <th className="ui-select-head">{selectAllOf(entries)}</th> : null}
              {columns.map((column) => (
                <th key={`column:${column.name}`} data-ui-path={columnPath(column["data-ui-path"])}>
                  {sortHeading(column.field, fieldLabel(column), sortableColumn(column))}
                  <HelpNote help={column.help} />
                </th>
              ))}
              {items.map((item) => (
                <th key={`item:${item.name}`} className="ui-item-head">
                  {sortHeading(item.name, humanise(item.name), itemSortable(item))}
                </th>
              ))}
              {toggles.map((action) => {
                const field = toggleField(action);
                return (
                  <th key={`toggle:${action.name}`} className="ui-toggle-head">
                    {sortHeading(field, action.label ?? humanise(action.name), allowed.includes(field) || allowed.includes(action.name))}
                  </th>
                );
              })}
              {actionsColumn ? <th className="ui-actions-head">Actions</th> : null}
            </tr>
          </thead>
          <tbody>{entries.map(renderRow)}</tbody>
        </table>
      </div>
    );
  // Above cards, a list or a tree: one select-all over every row, and the declared sort, which a
  // table puts in its header (one select-all per group's table, over that group's rows).
  const tools =
    !table && (multiple || sortOptions.length > 0) ? (
      <div className="ui-collection-tools">
        {multiple ? (
          <label className="ui-select-all-label">
            {selectAllOf(rows)}
            <span>Select all</span>
          </label>
        ) : null}
        {sortOptions.length > 0 ? (
          <span className="ui-sort-control">
            <label>
              <span className="ui-form-label">Sort by</span>
              <select
                aria-label="Sort by"
                value={clientSort?.by ?? ""}
                onChange={(event: ChangeEvent<HTMLSelectElement>) => {
                  if (event.target.value !== "") {
                    applySort({ by: event.target.value, dir: clientSort?.dir ?? "asc" });
                  }
                }}
              >
                {clientSort === undefined ? <option value="">None</option> : null}
                {sortOptions.map((option) => (
                  <option key={option.field} value={option.field}>
                    {option.label}
                  </option>
                ))}
              </select>
            </label>
            <button
              type="button"
              className="ui-button ui-icon-button ui-sort-dir"
              aria-label={clientSort?.dir === "desc" ? "Descending" : "Ascending"}
              disabled={clientSort === undefined}
              onClick={() => {
                if (clientSort) {
                  applySort({ by: clientSort.by, dir: clientSort.dir === "asc" ? "desc" : "asc" });
                }
              }}
            >
              {clientSort?.dir === "desc" ? "▼" : "▲"}
            </button>
          </span>
        ) : null}
      </div>
    ) : null;
  const bulkActions = props.bulkActions ?? [];
  return (
    <div className={`ui-collection ui-collection-style-${props.style ?? "table"}`} data-ui-path={useUiPath(props["data-ui-path"])}>
      {props.actions && props.actions.length > 0 ? (
        <div className="ui-collection-actions">
          {props.actions.map((action) => (
            <ActionControl key={action.name} action={action} />
          ))}
        </div>
      ) : null}
      {tools}
      {selectionOn && bulkActions.length > 0 && selected.length > 0 ? (
        <div className="ui-bulk-menu" role="toolbar" aria-label="Bulk actions">
          <span className="ui-bulk-count">{selected.length} selected</span>
          <ScopeLayer values={{ selection: selected }}>
            {bulkActions.map((action) => (
              <ActionControl key={action.name} action={action} />
            ))}
          </ScopeLayer>
        </div>
      ) : null}
      {groups.map(([group, entries]) => (
        <div key={group} className="ui-group">
          {props.groupBy ? <h3>{group}</h3> : null}
          {list(entries)}
        </div>
      ))}
      {data && props.pager ? <Pager pager={props.pager} total={data.total} rows={rows.length} /> : null}
    </div>
  );
}

/**
 * Orders two values of a sort, a total order: numbers (and, under a numeric column, text that
 * reads as one) by value and before every other value; the others by their text.
 */
export function compareValues(left: unknown, right: unknown, asNumber = false): number {
  const a = numeric(left, asNumber);
  const b = numeric(right, asNumber);
  if (a !== undefined && b !== undefined) {
    return a < b ? -1 : a > b ? 1 : 0;
  }
  if (a !== undefined || b !== undefined) {
    return a !== undefined ? -1 : 1;
  }
  const l = stableKey(left);
  const r = stableKey(right);
  return l < r ? -1 : l > r ? 1 : 0;
}

function numeric(value: unknown, asNumber: boolean): number | undefined {
  if (typeof value === "number") {
    return Number.isFinite(value) ? value : undefined;
  }
  if (asNumber && typeof value === "string" && value.trim() !== "") {
    const number = Number(value);
    return Number.isFinite(number) ? number : undefined;
  }
  return undefined;
}

/** A name as a heading: `owner_name` reads `owner name`. */
function humanise(name: string): string {
  return name.replace(/_/g, " ");
}

/** The row field a toggle column sorts by: the `row.<field>` its state reads, else its name. */
function toggleField(action: ActionSpec): string {
  const read = action.checked === undefined ? null : /^row\.([A-Za-z_][\w.]*)$/.exec(action.checked.trim());
  return read ? read[1] : action.name;
}

/**
 * Previous, the page (of how many, when the total and the size are known), Next (disabled on
 * the last page when they are), and with a size path a per-page select that returns to page 1.
 * The size counts pages only when its state holds a number of at least 1. The select offers that
 * size even when `sizes` does not list it, any other value the state holds (0, a negative, text)
 * as an entry of its own text, and a "Default" entry only while the state holds nothing
 * (`undefined`, `null`, `""`), so it always shows what the read sends. Reads and writes only the
 * state paths it is handed.
 */
function Pager(props: {
  pager: { page: string; size?: string; sizes?: number[]; declared?: boolean };
  total?: number;
  rows: number;
}): ReactNode {
  const scope = useScope();
  const { pager, total } = props;
  const current = evaluate(pager.page, scope.values);
  if (!pager.declared && (current === undefined || total === undefined || total <= props.rows)) {
    return null;
  }
  const page = Number(current ?? 1) || 1;
  const held = pager.size === undefined ? undefined : evaluate(pager.size, scope.values);
  const unset = held === undefined || held === null || held === "";
  const size = pageSize(held);
  const other = unset || size !== undefined ? undefined : typeof held === "object" ? JSON.stringify(held) : String(held);
  const sizes = [...(pager.sizes ?? [])];
  if (size !== undefined && !sizes.includes(size)) {
    sizes.push(size);
    sizes.sort((left, right) => left - right);
  }
  const pages = pager.declared && total !== undefined && size !== undefined ? Math.max(1, Math.ceil(total / size)) : undefined;
  return (
    <div className="ui-pager">
      <button type="button" className="ui-button" disabled={page <= 1} onClick={() => scope.set(pager.page, page - 1)}>
        Previous
      </button>
      <span>{pages === undefined ? `Page ${page}` : `Page ${page} of ${pages}`}</span>
      <button
        type="button"
        className="ui-button"
        disabled={pages !== undefined && page >= pages}
        onClick={() => scope.set(pager.page, page + 1)}
      >
        Next
      </button>
      {pager.size !== undefined ? (
        <label className="ui-page-size">
          <span className="ui-form-label">Per page</span>
          <select
            value={size !== undefined ? String(size) : (other ?? "")}
            onChange={(event: ChangeEvent<HTMLSelectElement>) => {
              const chosen = pageSize(event.target.value);
              if (chosen !== undefined) {
                setPaths(scope, [
                  [pager.size as string, chosen],
                  [pager.page, 1],
                ]);
              }
            }}
          >
            {unset ? <option value="">Default</option> : null}
            {other !== undefined ? <option value={other}>{other}</option> : null}
            {sizes.map((option) => (
              <option key={option} value={String(option)}>
                {option}
              </option>
            ))}
          </select>
        </label>
      ) : null}
    </div>
  );
}

/** A page size the read sends: a number of at least 1, or `undefined` when the state holds none. */
function pageSize(value: unknown): number | undefined {
  const size = typeof value === "number" ? value : typeof value === "string" && value.trim() !== "" ? Number(value) : Number.NaN;
  return Number.isFinite(size) && size >= 1 ? size : undefined;
}

/**
 * Writes each `[path, value]` in one update where the paths share a state below its root
 * (`state.q.page` and `state.q.size`): one `set` of that state with every member changed, since
 * a second `set` would rebuild it from the values read at render and drop the first write.
 * Paths in different states write one by one.
 */
function setPaths(scope: Scope, writes: readonly (readonly [string, unknown])[]): void {
  const segments = writes.map(([path]) => assignable(path));
  let shared = 0;
  if (segments.every((path): path is string[] => path !== null)) {
    const shortest = Math.min(...segments.map((path) => path.length));
    while (shared < shortest - 1 && segments.every((path) => path[shared] === segments[0][shared])) {
      shared += 1;
    }
  }
  if (shared < 2) {
    for (const [path, value] of writes) {
      scope.set(path, value);
    }
    return;
  }
  const prefix = (segments[0] as string[]).slice(0, shared);
  let next = getPath(scope.values, prefix);
  writes.forEach(([, value], index) => {
    next = setPath(next, (segments[index] as string[]).slice(shared), value);
  });
  scope.set(prefix.join("."), next);
}

/**
 * Rows under their `by` value: the `order` values first, in that order, then every other value
 * in the order it first appears. With `showEmpty` an `order` value no row has is kept, empty.
 */
export function groupRows<T>(rows: readonly T[], by: string, order: readonly string[] = [], showEmpty = false): [string, T[]][] {
  const names = [...order];
  for (const row of rows) {
    const name = String(display(row, by));
    if (!names.includes(name)) {
      names.push(name);
    }
  }
  return names
    .map((name): [string, T[]] => [name, rows.filter((row) => String(display(row, by)) === name)])
    .filter(([name, entries]) => entries.length > 0 || (showEmpty && order.includes(name)));
}
