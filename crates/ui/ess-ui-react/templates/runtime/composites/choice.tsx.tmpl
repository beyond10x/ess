import type { ChangeEvent, ReactNode } from "react";
import { useUiPath } from "../core";
import { useScope } from "../core";
import { filterRead, useRead, type ReadSpec, type ReadState } from "../data";
import { evaluate } from "../expr";
import { isObject, type Json } from "../json";

/** One option of a choice. */
export interface ChoiceOption {
  value: Json;
  label: string;
}

/** Pick one or several values, from fixed options or a read. */
export function ChoiceView(props: {
  "data-ui-path"?: string;
  reads?: ReadSpec;
  /** The rows a live node reads for the choice, its events applied: the options come from them (#354). */
  data?: ReadState;
  options?: ChoiceOption[];
  binds?: string;
  /** The row key an option's value is read from before `id` (the form field the choice picks for). */
  valueKey?: string;
  /** The row field each option sends (`value`, else the read's `key`); a row without it offers none. */
  valueField?: string;
  /** The row field each option shows (`label`). */
  labelField?: string;
  /** The row field carrying the identity of the entity the view projects, from the binding. */
  identity?: string;
  multiple?: boolean;
  style?: "dropdown" | "tags" | "tree" | "grouped" | "radio" | "segmented" | "checklist";
  creatable?: { does: string };
  note?: string;
  label?: string;
}): ReactNode {
  const scope = useScope();
  const raw = useRead(props.reads, scope.values, props.reads !== undefined);
  const read =
    props.data ??
    (props.reads?.filter === undefined ? raw : filterRead(raw, props.reads.filter, scope.values));
  // The option a row offers (beyond10x/ess#328), as `ess_ui::Choice::row_option` says: a named
  // value field is authoritative and a row without it offers nothing; otherwise the field named
  // like the form field, the view's identity, `id`, then the row's `value`.
  const options: ChoiceOption[] = props.reads || props.data
    ? read.rows.reduce<ChoiceOption[]>((offered, row) => {
        if (!isObject(row)) {
          if (props.valueField === undefined) {
            offered.push({ value: row, label: String(row) });
          }
          return offered;
        }
        if (props.valueField !== undefined && !(props.valueField in row)) {
          return offered;
        }
        // A field present on the row is taken, `null` included; a label `null` is absent.
        const key = [props.valueField, props.valueKey, props.identity, "id"].find(
          (candidate) => candidate !== undefined && candidate in row,
        );
        const value = key !== undefined ? (row[key] ?? null) : (row.value ?? null);
        const label =
          (props.labelField === undefined ? undefined : row[props.labelField]) ?? row.label ?? row.name ?? value;
        offered.push({ value, label: label === null ? "" : String(label) });
        return offered;
      }, [])
    : props.options ?? [];
  const current = props.binds ? evaluate(props.binds, scope.values) : undefined;
  const selected = (Array.isArray(current) ? current : current === undefined || current === null ? [] : [current]).map(String);
  const pick = (value: Json) => {
    let next: unknown = value;
    if (props.multiple) {
      const key = String(value);
      next = selected.includes(key)
        ? options.filter((option) => selected.includes(String(option.value)) && String(option.value) !== key).map((option) => option.value)
        : [...options.filter((option) => selected.includes(String(option.value))).map((option) => option.value), value];
    }
    if (props.binds) {
      scope.set(props.binds, next);
    } else {
      scope.pick?.(next);
    }
  };
  let control: ReactNode;
  if (props.style === "segmented" || props.style === "tags" || props.style === "checklist" || props.style === "radio" || (props.multiple && props.style !== "dropdown")) {
    control = (
      <div className={`ui-choice-${props.style ?? "checklist"}`} role="group" aria-label={props.label}>
        {options.map((option) => (
          <button
            key={String(option.value)}
            type="button"
            className={`ui-chip${selected.includes(String(option.value)) ? " ui-chip-on" : ""}`}
            aria-pressed={selected.includes(String(option.value))}
            onClick={() => pick(option.value)}
          >
            {option.label}
          </button>
        ))}
      </div>
    );
  } else {
    control = (
      <select
        aria-label={props.label}
        value={selected[0] ?? ""}
        onChange={(event: ChangeEvent<HTMLSelectElement>) => {
          const option = options.find((entry) => String(entry.value) === event.target.value);
          pick(option ? option.value : null);
        }}
      >
        <option value="">{props.label ?? "—"}</option>
        {options.map((option) => (
          <option key={String(option.value)} value={String(option.value)}>
            {option.label}
          </option>
        ))}
      </select>
    );
  }
  return (
    <div className="ui-choice" data-ui-path={useUiPath(props["data-ui-path"])}>
      {control}
      {props.note ? <small className="ui-note">{props.note}</small> : null}
    </div>
  );
}
