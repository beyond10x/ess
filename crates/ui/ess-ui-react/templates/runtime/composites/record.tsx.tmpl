//+nocollapse
import type { ReactNode } from "react";
//-nocollapse
//+collapse
import { useState, type ReactNode } from "react";
//-collapse
import { useUiPath } from "../core";
import { ActionControl, type ActionSpec } from "../actions";
import { ScopeLayer, useData, useScope } from "../core";
import type { ReadSpec } from "../data";
import { evaluate, truthy } from "../expr";
import { FieldValue, Tabs, fieldLabel, useLabelled, type FieldSpec, type TabSpec } from "../fields";

//+collapse
/** Fields of a record under a heading; a collapsed group starts closed, its body stays mounted. */
export interface RecordGroupSpec {
  "data-ui-path": string;
  name: string;
  label?: string;
  collapsed?: boolean;
  fields: FieldSpec[];
}

function RecordGroupBox(props: {
  "data-ui-path"?: string;
  label?: string;
  collapsed?: boolean;
  children?: ReactNode;
}): ReactNode {
  const [open, setOpen] = useState(!props.collapsed);
  const bodyId = `${props["data-ui-path"]}#body`;
  return (
    <section className="ui-record-group" data-ui-path={props["data-ui-path"]}>
      {props.label ? (
        <h3 className="ui-record-group-title">
          {props.collapsed ? (
            <button type="button" className="ui-collapse" aria-expanded={open} aria-controls={bodyId} onClick={() => setOpen(!open)}>
              {props.label}
            </button>
          ) : (
            props.label
          )}
        </h3>
      ) : null}
      <div className="ui-collapse-body" id={bodyId} hidden={!open}>
        {props.children}
      </div>
    </section>
  );
}

//-collapse
/** One row shown as labelled fields. */
export function RecordView(props: {
  "data-ui-path"?: string;
  reads?: ReadSpec;
  fields?: FieldSpec[];
//+collapse
  groups?: RecordGroupSpec[];
//-collapse
  tabs?: TabSpec[];
  item?: ReactNode;
  actions?: ActionSpec[];
}): ReactNode {
  const scope = useScope();
  const data = useData(props.reads);
  const row = data ? data.rows[0] : scope.values.row;
//+nocollapse
  const labelled = useLabelled([...(props.fields ?? []), ...(props.tabs ?? []).flatMap((tab) => tab.fields ?? [])]);
//-nocollapse
//+collapse
  const labelled = useLabelled([
    ...(props.fields ?? []),
    ...(props.groups ?? []).flatMap((group) => group.fields),
    ...(props.tabs ?? []).flatMap((tab) => tab.fields ?? []),
  ]);
//-collapse
  const list = (fields: FieldSpec[]) => (
    <dl className="ui-record-fields">
      {fields
        .filter((field) => field.visible === undefined || truthy(evaluate(field.visible, scope.values)))
        .map((field) => (
          <div key={field.name}>
            <dt>{fieldLabel(field)}</dt>
            <dd>
              <FieldValue field={field} row={labelled(row)} />
            </dd>
          </div>
        ))}
    </dl>
  );
  return (
    <ScopeLayer values={{ row }}>
      <div className="ui-record" data-ui-path={useUiPath(props["data-ui-path"])}>
        {props.fields && props.fields.length > 0 ? list(props.fields) : null}
//+collapse
        {(props.groups ?? []).map((group) => (
          <RecordGroupBox key={group.name} data-ui-path={useUiPath(group["data-ui-path"])} label={group.label} collapsed={group.collapsed}>
            {list(group.fields)}
          </RecordGroupBox>
        ))}
//-collapse
        {props.tabs && props.tabs.length > 0 ? (
          <Tabs tabs={props.tabs} panel={(tab) => (tab.fields ? list(tab.fields) : tab.content)} />
        ) : null}
        {props.item ? <div className="ui-item">{props.item}</div> : null}
        {props.actions && props.actions.length > 0 ? (
          <div className="ui-record-actions">
            {props.actions.map((action) => (
              <ActionControl key={action.name} action={action} />
            ))}
          </div>
        ) : null}
      </div>
    </ScopeLayer>
  );
}
