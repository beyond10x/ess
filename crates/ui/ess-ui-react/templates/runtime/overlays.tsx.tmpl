// Overlays: drawers, dialogs, full-screen views and popovers opened by an action.

import { useState, type ReactNode } from "react";
import { useUiPath } from "./core";
import { FramePath, ScopeLayer, useScope, type Opener } from "./core";
import { isObject } from "./json";

/** The overlays a page or shell holds, by name. */
export type OverlayTable = Record<string, () => ReactNode>;

/** One open overlay: its name, the params its opener passed, and what confirming it runs. */
interface OpenOverlay {
  name: string;
  params: Record<string, unknown>;
  opener?: Opener;
}

/**
 * Holds which of its overlays are open and renders each with its params. An overlay opened from
 * inside another stacks on it: the one below stays open, and closing the top one returns to it.
 * Opening an overlay that is already open brings it to the top with the new params. Closing an
 * overlay closes the ones stacked on it too. What an opener passes is the row it ran on; the
 * overlay's scope carries it as `opener_row`, which no expression can name, so an overlay
 * evaluates its own `params` (`row.<field>`) against it.
 */
export function OverlayHost(props: { overlays: OverlayTable; children?: ReactNode }): ReactNode {
  const parent = useScope();
  const [stack, setStack] = useState<OpenOverlay[]>([]);
  const baseParams = isObject(parent.values.params) ? parent.values.params : {};
  return (
    <ScopeLayer
      actions={{
        open: (name: string, params?: Record<string, unknown>, opener?: Opener) => {
          if (name in props.overlays) {
            setStack((open) => [...open.filter((entry) => entry.name !== name), { name, params: params ?? {}, opener }]);
          } else {
            parent.open(name, params, opener);
          }
        },
      }}
    >
      {props.children}
      {stack.map((entry) => {
        const render = props.overlays[entry.name];
        const close = () =>
          setStack((open) => {
            const at = open.findIndex((candidate) => candidate.name === entry.name);
            return at < 0 ? open : open.slice(0, at);
          });
        return render ? (
          <ScopeLayer
            key={entry.name}
            values={{ params: { ...baseParams, ...entry.params }, opener_row: entry.params }}
            actions={{ close, confirmed: entry.opener }}
          >
            {render()}
          </ScopeLayer>
        ) : null;
      })}
    </ScopeLayer>
  );
}

/** The frame of one open overlay. */
export function OverlayFrame(props: {
  "data-ui-path": string;
  kind: "drawer" | "dialog" | "fullscreen" | "popover";
  title?: string;
  /** The host slot the overlay is: the `host` its component is registered under. */
  host?: string;
  children?: ReactNode;
}): ReactNode {
  const scope = useScope();
  return (
    <div className={`ui-overlay-backdrop ui-backdrop-${props.kind}`} onClick={() => scope.close()}>
      <div
        className={`ui-overlay ui-overlay-${props.kind}`}
        role="dialog"
        aria-modal="true"
        aria-label={props.title}
        data-ui-path={useUiPath(props["data-ui-path"])}
        data-ui-host={props.host}
        onClick={(event: { stopPropagation(): void }) => event.stopPropagation()}
      >
        <div className="ui-overlay-head">
          {props.title ? <h2>{props.title}</h2> : null}
          <button type="button" className="ui-button ui-icon-button" aria-label="Close" onClick={() => scope.close()}>
            ×
          </button>
        </div>
        <div className="ui-overlay-body">
          <FramePath path={props["data-ui-path"]}>{props.children}</FramePath>
        </div>
      </div>
    </div>
  );
}
