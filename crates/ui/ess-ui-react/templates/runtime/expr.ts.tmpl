// Binding expressions (`expressions` in the ess-ui/1 schema): short paths rooted at a known
// name, plus `==`, `!=`, `in [..]`, `not`, `and`, `or`, literals and calls such as
// `same_as(list)`, `matches(params)` and `actor.may(<command>)`. A bare word is its own text, so
// `row.status == overdue` compares with the text "overdue"; a string that does not parse as an
// expression is literal text.

import { getPath, isObject, stableKey } from "./json";

/** The roots an expression path may start with. */
export const ROOTS = [
  "state",
  "params",
  "args",
  "row",
  "selection",
  "draft",
  "section",
  "channel",
  "shell",
  "url",
  "actor",
  "widget",
  "same_as",
  "matches",
] as const;

type Token =
  | { kind: "word"; text: string }
  | { kind: "number"; value: number }
  | { kind: "string"; value: string }
  | { kind: "op"; text: string };

type Ast =
  | { kind: "literal"; value: unknown }
  | { kind: "path"; segments: string[] }
  | { kind: "list"; items: Ast[] }
  | { kind: "call"; callee: Ast; args: Ast[] }
  | { kind: "not"; operand: Ast }
  | { kind: "binary"; op: string; left: Ast; right: Ast };

class ParseError extends Error {}

function tokenize(text: string): Token[] {
  const tokens: Token[] = [];
  let index = 0;
  while (index < text.length) {
    const char = text[index];
    if (char === " " || char === "\t" || char === "\n") {
      index += 1;
    } else if (text.startsWith("==", index) || text.startsWith("!=", index)) {
      tokens.push({ kind: "op", text: text.slice(index, index + 2) });
      index += 2;
    } else if ("()[]{},.".includes(char)) {
      tokens.push({ kind: "op", text: char });
      index += 1;
    } else if (char === "'" || char === '"') {
      const end = text.indexOf(char, index + 1);
      if (end < 0) {
        throw new ParseError("unterminated string");
      }
      tokens.push({ kind: "string", value: text.slice(index + 1, end) });
      index = end + 1;
    } else if (/[0-9]/.test(char)) {
      const match = /^[0-9]+(\.[0-9]+)?/.exec(text.slice(index));
      const digits = match ? match[0] : char;
      tokens.push({ kind: "number", value: Number(digits) });
      index += digits.length;
    } else if (/[A-Za-z_]/.test(char)) {
      const match = /^[A-Za-z_][A-Za-z0-9_-]*/.exec(text.slice(index));
      const word = match ? match[0] : char;
      tokens.push({ kind: "word", text: word });
      index += word.length;
    } else {
      throw new ParseError(`unexpected ${char}`);
    }
  }
  return tokens;
}

class Parser {
  private index = 0;
  constructor(private readonly tokens: Token[]) {}

  parse(): Ast {
    const ast = this.or();
    if (this.index !== this.tokens.length) {
      throw new ParseError("trailing input");
    }
    return ast;
  }

  private peek(): Token | undefined {
    return this.tokens[this.index];
  }

  private isOp(text: string): boolean {
    const token = this.peek();
    return token !== undefined && token.kind === "op" && token.text === text;
  }

  private isWord(text: string): boolean {
    const token = this.peek();
    return token !== undefined && token.kind === "word" && token.text === text;
  }

  private expectOp(text: string): void {
    if (!this.isOp(text)) {
      throw new ParseError(`expected ${text}`);
    }
    this.index += 1;
  }

  private or(): Ast {
    let left = this.and();
    while (this.isWord("or")) {
      this.index += 1;
      left = { kind: "binary", op: "or", left, right: this.and() };
    }
    return left;
  }

  private and(): Ast {
    let left = this.not();
    while (this.isWord("and")) {
      this.index += 1;
      left = { kind: "binary", op: "and", left, right: this.not() };
    }
    return left;
  }

  private not(): Ast {
    if (this.isWord("not")) {
      this.index += 1;
      return { kind: "not", operand: this.not() };
    }
    return this.comparison();
  }

  private comparison(): Ast {
    const left = this.primary();
    if (this.isOp("==") || this.isOp("!=")) {
      const token = this.peek() as { kind: "op"; text: string };
      this.index += 1;
      return { kind: "binary", op: token.text, left, right: this.primary() };
    }
    if (this.isWord("in")) {
      this.index += 1;
      return { kind: "binary", op: "in", left, right: this.primary() };
    }
    return left;
  }

  private list(close: string): Ast {
    const items: Ast[] = [];
    while (!this.isOp(close)) {
      items.push(this.or());
      if (!this.isOp(close)) {
        this.expectOp(",");
      }
    }
    this.index += 1;
    return { kind: "list", items };
  }

  private primary(): Ast {
    const token = this.peek();
    if (token === undefined) {
      throw new ParseError("unexpected end");
    }
    this.index += 1;
    if (token.kind === "number") {
      return { kind: "literal", value: token.value };
    }
    if (token.kind === "string") {
      return { kind: "literal", value: token.value };
    }
    if (token.kind === "op") {
      if (token.text === "(") {
        const inner = this.or();
        this.expectOp(")");
        return inner;
      }
      if (token.text === "[") {
        return this.list("]");
      }
      if (token.text === "{") {
        return this.list("}");
      }
      throw new ParseError(`unexpected ${token.text}`);
    }
    if (token.text === "true" || token.text === "false") {
      return { kind: "literal", value: token.text === "true" };
    }
    if (token.text === "null") {
      return { kind: "literal", value: null };
    }
    const segments = [token.text];
    while (this.isOp(".")) {
      this.index += 1;
      const next = this.peek();
      if (next === undefined || next.kind !== "word") {
        throw new ParseError("expected a name after .");
      }
      segments.push(next.text);
      this.index += 1;
    }
    let ast: Ast = { kind: "path", segments };
    while (this.isOp("(")) {
      this.index += 1;
      const args = this.list(")") as { kind: "list"; items: Ast[] };
      ast = { kind: "call", callee: ast, args: args.items };
    }
    return ast;
  }
}

const cache = new Map<string, Ast | null>();

function parse(text: string): Ast | null {
  const cached = cache.get(text);
  if (cached !== undefined) {
    return cached;
  }
  let ast: Ast | null;
  try {
    ast = new Parser(tokenize(text)).parse();
  } catch {
    ast = null;
  }
  cache.set(text, ast);
  return ast;
}

function isRoot(name: string): boolean {
  return (ROOTS as readonly string[]).includes(name);
}

/** Whether a value counts as true. */
export function truthy(value: unknown): boolean {
  if (Array.isArray(value)) {
    return value.length > 0;
  }
  return Boolean(value);
}

function equal(left: unknown, right: unknown): boolean {
  if (Array.isArray(left) && Array.isArray(right)) {
    const a = left.map(stableKey).sort();
    const b = right.map(stableKey).sort();
    return a.length === b.length && a.every((entry, index) => entry === b[index]);
  }
  if (isObject(left) || isObject(right)) {
    return stableKey(left) === stableKey(right);
  }
  return String(left ?? "") === String(right ?? "");
}

function run(ast: Ast, values: Record<string, unknown>): unknown {
  switch (ast.kind) {
    case "literal":
      return ast.value;
    case "list":
      return ast.items.map((item) => run(item, values));
    case "path": {
      const [root, ...rest] = ast.segments;
      if (!isRoot(root)) {
        return ast.segments.join(".");
      }
      return getPath(values[root], rest);
    }
    case "call": {
      const callee = ast.callee.kind === "path" && isRoot(ast.callee.segments[0])
        ? run(ast.callee, values)
        : undefined;
      if (typeof callee !== "function") {
        return undefined;
      }
      const args = ast.args.map((arg) =>
        arg.kind === "path" && !isRoot(arg.segments[0])
          ? arg.segments.join(".")
          : run(arg, values),
      );
      return (callee as (...args: unknown[]) => unknown)(...args);
    }
    case "not":
      return !truthy(run(ast.operand, values));
    case "binary": {
      if (ast.op === "and") {
        return truthy(run(ast.left, values)) && truthy(run(ast.right, values));
      }
      if (ast.op === "or") {
        return truthy(run(ast.left, values)) || truthy(run(ast.right, values));
      }
      const left = run(ast.left, values);
      const right = run(ast.right, values);
      if (ast.op === "==") {
        return equal(left, right);
      }
      if (ast.op === "!=") {
        return !equal(left, right);
      }
      if (Array.isArray(right)) {
        return right.some((entry) => equal(left, entry));
      }
      return false;
    }
  }
}

/** Evaluates an expression against the scope's values; literal text evaluates to itself. */
export function evaluate(text: string | undefined, values: Record<string, unknown>): unknown {
  if (text === undefined) {
    return undefined;
  }
  const ast = parse(text);
  if (ast === null || (operates(ast) && !reads(ast))) {
    return text;
  }
  return run(ast, values);
}

/** Whether the expression applies an operator (`not`, `and`, `or`, `in`, `==`, `!=`). */
function operates(ast: Ast): boolean {
  return ast.kind === "not" || ast.kind === "binary";
}

/**
 * Whether the expression reads a path from a root or calls a function. Words joined by an
 * operator that read nothing (`Limit in cents`, `not yet sent`) are literal text, as
 * `ess ui check` classifies them.
 */
function reads(ast: Ast): boolean {
  switch (ast.kind) {
    case "literal":
      return false;
    case "path":
      return isRoot(ast.segments[0]);
    case "call":
      return true;
    case "list":
      return ast.items.some(reads);
    case "not":
      return reads(ast.operand);
    case "binary":
      return reads(ast.left) || reads(ast.right);
  }
}

/** Whether an expression names a writable path (`state.x`, `draft.y`, `shell.z`). */
export function assignable(text: string): string[] | null {
  const ast = parse(text);
  if (ast === null || ast.kind !== "path" || !isRoot(ast.segments[0])) {
    return null;
  }
  return ast.segments;
}
