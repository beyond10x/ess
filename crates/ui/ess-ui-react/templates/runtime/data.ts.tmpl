//+plain
// Reads, commands and server-held state go through one `DataAdapter`. The default answers
// every read from the document's fixtures; `setDataAdapter(httpAdapter(base))` swaps in a real
// backend without touching a page.
//-plain
//+bound
// Reads, commands and server-held state go through one `DataAdapter`. The default answers
// every read from the document's fixtures; `main.tsx` swaps in `httpAdapter(binding)`, which
// reads and commands the paths the served surface answers, from `src/binding.ts`.
//-bound

import { useEffect, useRef, useState } from "react";
import { fixtures, type FixtureView } from "../fixtures";
import { evaluate, keeps } from "./expr";
import { getPath, isObject, stableKey, type Json, type JsonObject } from "./json";
//+bound
import { classify, type Answer } from "./answer";
//-bound

/** A read as a section or composite declares it. */
export interface ReadSpec {
  view: string;
  filter?: string;
  params?: Record<string, string>;
  paging?: string;
  debounce?: number;
  refresh?: string;
}

/** A read with its params evaluated. */
export interface ReadRequest {
  view: string;
  params: Record<string, unknown>;
  paging?: string;
//+bound
  /** Aborts the request when the read is dropped before it answers. */
  signal?: AbortSignal;
//-bound
}

/** What a read returns. */
export interface ReadResult {
  rows: Json[];
  total?: number;
}

/** A read or command the backend refused; `status` 403 renders as forbidden. */
export class DataError extends Error {
  constructor(
    message: string,
    readonly status: number,
  ) {
    super(message);
  }
}

/** The backend seam: every read, command and server-held state goes through it. */
export interface DataAdapter {
  read(request: ReadRequest): Promise<ReadResult>;
  send(command: string, input: Record<string, unknown>): Promise<Json>;
  loadState(store: "server" | "server_session", key: string): Promise<Json | undefined>;
  saveState(store: "server" | "server_session", key: string, value: Json): Promise<void>;
}

const LATENCY_MS = 120;

function delay<T>(value: T): Promise<T> {
  return new Promise((resolve) => setTimeout(() => resolve(value), LATENCY_MS));
}

function fixtureView(view: string, params: Record<string, unknown>, depth = 0): FixtureView | undefined {
  const direct = fixtures.views[view];
  if (direct !== undefined) {
    return direct;
  }
  const derived = fixtures.derived[view];
  if (derived === undefined || depth > 8) {
    return undefined;
  }
  if ("same_as" in derived) {
    return fixtureView(derived.same_as, params, depth + 1);
  }
  const source = fixtureView(derived.by_id_from, params, depth + 1);
  if (source === undefined) {
    return undefined;
  }
  const wanted = params[derived.key] ?? params.id;
  const rows = source.rows.filter((row) => isObject(row) && String(row[derived.key]) === String(wanted));
  return { rows: rows.length > 0 ? rows : source.rows.slice(0, 1) };
}

function matchesParams(row: Json, params: Record<string, unknown>): boolean {
  if (!isObject(row)) {
    return true;
  }
  for (const [name, value] of Object.entries(params)) {
    if (value === undefined || value === null || value === "") {
      continue;
    }
    if (name === "q" || name === "search") {
      const text = Object.values(row).map((entry) => JSON.stringify(entry)).join(" ").toLowerCase();
      if (!text.includes(String(value).toLowerCase())) {
        return false;
      }
      continue;
    }
    if (!(name in row)) {
      continue;
    }
    const field = row[name];
    const wanted = Array.isArray(value) ? value : [value];
    if (wanted.length === 0) {
      continue;
    }
    const have = Array.isArray(field) ? field : [field];
    if (!have.some((entry) => wanted.some((want) => String(want) === String(entry)))) {
      return false;
    }
  }
  return true;
}

/** The default adapter: reads answered from fixtures, commands and state kept in memory. */
export const fixtureAdapter: DataAdapter = {
  read(request) {
    const view = fixtureView(request.view, request.params);
    if (view === undefined) {
      return Promise.reject(new DataError(`no fixture answers ${request.view}`, 404));
    }
    let rows = view.rows.filter((row) => matchesParams(row, request.params));
    const sort = request.params.sort;
    if (isObject(sort) && typeof sort.by === "string") {
      const by = sort.by;
      const direction = sort.dir === "desc" ? -1 : 1;
      rows = [...rows].sort((a, b) =>
        stableKey(getPath(a, [by])) < stableKey(getPath(b, [by])) ? -direction : direction,
      );
    }
    const total = rows.length;
    if (request.paging === "server" || request.paging === "cursor") {
      const size = Number(request.params.size ?? 25) || 25;
      const page = Number(request.params.page ?? 1) || 1;
      rows = rows.slice((page - 1) * size, page * size);
    }
    return delay({ rows, total: view.total ?? total });
  },
  send(command, input) {
    return delay({ command, accepted: true, input: input as JsonObject });
  },
  loadState(store, key) {
    return delay(memoryState.get(`${store}:${key}`));
  },
  saveState(store, key, value) {
    memoryState.set(`${store}:${key}`, value);
    return delay(undefined);
  },
};

const memoryState = new Map<string, Json>();

//+plain
async function answer(response: Response): Promise<Json> {
  if (!response.ok) {
    throw new DataError(`${response.status} ${response.statusText}`, response.status);
  }
  return (await response.json()) as Json;
}

/** An adapter for a backend serving `GET /views/<view>`, `POST /commands/<command>` and `/state`. */
export function httpAdapter(base: string): DataAdapter {
  return {
    async read(request) {
      const query = new URLSearchParams({ params: JSON.stringify(request.params) });
      if (request.paging) {
        query.set("paging", request.paging);
      }
      const body = await answer(await fetch(`${base}/views/${request.view}?${query}`));
      if (isObject(body) && Array.isArray(body.rows)) {
        return { rows: body.rows, total: typeof body.total === "number" ? body.total : undefined };
      }
      return { rows: Array.isArray(body) ? body : [body] };
    },
    async send(command, input) {
      return answer(
        await fetch(`${base}/commands/${command}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(input),
        }),
      );
    },
    async loadState(store, key) {
      const response = await fetch(`${base}/state/${store}/${encodeURIComponent(key)}`);
      return response.status === 404 ? undefined : answer(response);
    },
    async saveState(store, key, value) {
      await answer(
        await fetch(`${base}/state/${store}/${encodeURIComponent(key)}`, {
          method: "PUT",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(value),
        }),
      );
    },
  };
}
//-plain
//+bound
/** Every route the document's views and commands bind to, by served component (`ess_ui::binding`). */
export interface Binding {
  system: string;
  components: Record<string, ServedComponent>;
  /** Every view and command name as the document writes it, to its qualified name. */
  names: Record<string, string>;
  /** Every model enum a choice's `options` name, by qualified name (beyond10x/ess#330). */
  enums?: Record<string, { value: string; label: string }[]>;
}

/** What one served component answers for the document. */
export interface ServedComponent {
  views: Record<string, ViewRoute>;
  commands: Record<string, CommandRoute>;
}

/** A view read by `GET` on `path`, its parameters in the query. */
export interface ViewRoute {
  path: string;
  params: QueryParam[];
  /** The row field carrying the identity of the entity the view projects (beyond10x/ess#328). */
  identity?: string;
}

/** One view parameter: the name a read binds it by and the query key it travels under. */
export interface QueryParam {
  name: string;
  wire: string;
  required: boolean;
  scalar: string;
}

/** A command sent by `POST` on `path`, and the errors it can answer with. */
export interface CommandRoute {
  path: string;
  body_required: boolean;
  errors: Record<string, ErrorRoute>;
}

/** One declared error: the status its branch answers with and what it is shown as. */
export interface ErrorRoute {
  status: number;
  display: string;
}

/**
 * A command the served surface did not accept: its classified answer, and for a declared
 * error the text the binding shows it as. Rejected by `httpAdapter`'s `send`.
 */
export class CommandRefused extends DataError {
  constructor(
    readonly command: string,
    status: number,
    readonly answer: Exclude<Answer, { answer: "accepted" }>,
    readonly display: string,
  ) {
    super(`${command}: ${display}`, status);
  }
}

let authorization: string | undefined;

/**
 * Sets the `Authorization` header every request carries, as configured; never derived. How the
 * server authenticates it is the realization's. `undefined` sends none.
 */
export function setAuthorization(value: string | undefined): void {
  if (authorization === value) return;
  authorization = value;
  sourceVersion++;
  invalidate();
}

/**
 * The base URL a served component is reached at: the `content` of
 * `<meta name="ess-base-url:<component>">` in `www/index.html`; the page's own origin when the
 * tag is absent or empty.
 */
export function baseUrl(component: string): string {
  const meta = typeof document === "undefined" ? null : document.querySelector(`meta[name="ess-base-url:${component}"]`);
  return (meta?.getAttribute("content") ?? "").replace(/\/+$/, "");
}

function headers(json: boolean): Record<string, string> {
  const out: Record<string, string> = {};
  if (json) {
    out["content-type"] = "application/json";
  }
  if (authorization !== undefined) {
    out.authorization = authorization;
  }
  return out;
}

function served<K extends "views" | "commands">(
  binding: Binding,
  kind: K,
  name: string,
): { component: string; route: ServedComponent[K][string] } | undefined {
  const qualified = binding.names[name] ?? name;
  for (const [component, routes] of Object.entries(binding.components)) {
    const route = routes[kind][qualified];
    if (route !== undefined) {
      return { component, route: route as ServedComponent[K][string] };
    }
  }
  return undefined;
}

function shown(answer: Exclude<Answer, { answer: "accepted" }>, route: CommandRoute): string {
  switch (answer.answer) {
    case "refused":
      return route.errors[answer.error]?.display ?? answer.error;
    case "not_granted":
      return answer.actor === null ? "Not signed in as anyone this may be done by" : `Not permitted for ${answer.actor}`;
    case "malformed":
      return `Not accepted: ${answer.refused}`;
    case "unfinished":
      return answer.committed
        ? "Done, but not every effect was delivered: do not send it again"
        : "Not available yet: nothing was done";
    case "transport":
      return "No answer from the server";
  }
}

/**
 * The adapter for the served surface `binding` describes: a read is `GET <base><path>` with its
 * parameters under their query keys, a command `POST <base><path>` with its input as the body,
 * answered as `classify` reads the answer. `base` gives each served component's base URL.
 */
export function httpAdapter(binding: Binding, base: (component: string) => string = baseUrl): DataAdapter {
  return {
    async read(request) {
      const found = served(binding, "views", request.view);
      if (found === undefined) {
        throw new DataError(`no served component answers ${request.view}`, 404);
      }
      const query = new URLSearchParams();
      for (const param of found.route.params) {
        const value = request.params[param.name];
        if (value !== undefined && value !== null && value !== "") {
          query.set(param.wire, typeof value === "object" ? JSON.stringify(value) : String(value));
        }
      }
      const search = query.toString();
      const response = await fetch(`${base(found.component)}${found.route.path}${search ? `?${search}` : ""}`, {
        headers: headers(false),
        signal: request.signal,
      });
      const text = await response.text();
      if (response.status < 200 || response.status >= 300) {
        throw new DataError(`${response.status} ${request.view}`, response.status);
      }
      const body = JSON.parse(text) as Json;
      if (isObject(body) && Array.isArray(body.rows)) {
        return { rows: body.rows, total: typeof body.total === "number" ? body.total : undefined };
      }
      return { rows: Array.isArray(body) ? body : [body] };
    },
    async send(command, input) {
      const found = served(binding, "commands", command);
      if (found === undefined) {
        throw new DataError(`no served component accepts ${command}`, 404);
      }
      let status = 0;
      let text = "";
      try {
        const response = await fetch(`${base(found.component)}${found.route.path}`, {
          method: "POST",
          headers: headers(true),
          body: JSON.stringify(input),
        });
        status = response.status;
        text = await response.text();
      } catch {
        // No answer at all: classified as a transport failure below.
      }
      const answer = classify(status, text);
      if (answer.answer === "accepted") {
        return JSON.parse(text) as Json;
      }
      throw new CommandRefused(command, status, answer, shown(answer, found.route));
    },
    loadState(store) {
      return Promise.reject(new DataError(`the served surface holds no ${store} state`, 404));
    },
    saveState(store) {
      return Promise.reject(new DataError(`the served surface holds no ${store} state`, 404));
    },
  };
}
//-bound

let current: DataAdapter = fixtureAdapter;
let version = 0;
// Changing the source or actor also hides rows from the previous authority immediately.
let sourceVersion = 0;
const listeners = new Set<() => void>();

/** Replaces the adapter every read and command uses. */
export function setDataAdapter(adapter: DataAdapter): void {
  current = adapter;
  sourceVersion++;
  invalidate();
}

/** The adapter in use. */
export function dataAdapter(): DataAdapter {
  return current;
}

/** Marks every read stale, so mounted sections read again (after a command). */
export function invalidate(): void {
  version += 1;
  for (const listener of listeners) {
    listener();
  }
}

function useVersion(): number {
  const [seen, setSeen] = useState(version);
  useEffect(() => {
    const listener = () => setSeen(version);
    listeners.add(listener);
    return () => {
      listeners.delete(listener);
    };
  }, []);
  return seen;
}

/** Where a read is in its lifecycle. */
export type ReadStatus = "idle" | "loading" | "refreshing" | "ready" | "failed" | "forbidden";

/** A read's state as a section renders it. */
export interface ReadState {
  status: ReadStatus;
  /** Adapter/authority generation; live effects must not retain rows across a source change. */
  source?: number;
  /** This consumer's rows have a client predicate; selection follows its kept keys. */
  filtered?: boolean;
  rows: Json[];
  total?: number;
  error?: string;
  params: Record<string, unknown>;
  stale?: boolean;
  newCount?: number;
  /** `restart` gives up this subscriber's stalled request without aborting other subscribers. */
  refetch(restart?: boolean): void;
}

/** Per-consumer visibility over raw shared rows, after live effects and before local paging. */
export function filterRead(read: ReadState, filter: string | undefined, values: Record<string, unknown>): ReadState {
  if (filter === undefined) return read;
  const rows = read.rows.filter((row) => keeps(filter, { ...values, row }));
  return { ...read, rows, total: rows.length, filtered: true };
}

interface SharedRead {
  promise: Promise<ReadResult>;
  users: number;
  settled: boolean;
//+bound
  controller: AbortController;
//-bound
}
const sharedReads = new Map<string, SharedRead>();

/** A raw request is shared while any consumer holds it; filters never enter its key. */
function acquireRead(key: string, request: ReadRequest, refresh: boolean, restart: boolean): { promise: Promise<ReadResult>; release(): void } {
  let entry = sharedReads.get(key);
  if (!entry || restart || (refresh && entry.settled)) {
//+plain
    entry = { users: 0, settled: false, promise: current.read(request) };
//-plain
//+bound
    const controller = new AbortController();
    entry = { users: 0, settled: false, controller, promise: current.read({ ...request, signal: controller.signal }) };
//-bound
    sharedReads.set(key, entry);
    const created = entry;
    void created.promise.then(() => { created.settled = true; }, () => { created.settled = true; });
  }
  const held = entry;
  held.users++;
  return { promise: held.promise, release() {
    held.users--;
    if (held.users === 0) {
      if (sharedReads.get(key) === held) sharedReads.delete(key);
//+bound
      held.controller.abort();
//-bound
    }
  }};
}

/** Evaluates a read's params against the scope. */
export function evaluateParams(
  spec: ReadSpec | undefined,
  values: Record<string, unknown>,
): Record<string, unknown> {
  const params: Record<string, unknown> = {};
  for (const [name, expr] of Object.entries(spec?.params ?? {})) {
    params[name] = evaluate(expr, values);
  }
  return params;
}

/** Runs a read while `enabled`, again when its params change or a command invalidates it. */
export function useRead(
  spec: ReadSpec | undefined,
  values: Record<string, unknown>,
  enabled = true,
): ReadState {
  const params = evaluateParams(spec, values);
  const key = spec ? `${spec.view}|${stableKey(params)}|${spec.paging ?? ""}` : "";
  const seen = useVersion();
  const source = sourceVersion;
  const [nonce, setNonce] = useState(0);
  const startedNonce = useRef(0);
  const restartNext = useRef(false);
  const [state, setState] = useState<Omit<ReadState, "refetch" | "params"> & {source: number}>({
    status: spec && enabled ? "loading" : "idle",
    rows: [],
    source,
  });
  useEffect(() => {
    if (!spec || !enabled) {
      return;
    }
    let live = true;
    const refresh = startedNonce.current !== nonce;
    startedNonce.current = nonce;
    const restart = restartNext.current;
    restartNext.current = false;
    setState((previous) => ({
      ...(previous.source === source ? previous : { rows: [], source }),
      status: previous.source === source && previous.status === "ready" ? "refreshing" : "loading",
    }));
    let acquired: ReturnType<typeof acquireRead> | undefined;
    const start = () => {
      acquired = acquireRead(`${seen}|${source}|${key}`, { view: spec.view, params, paging: spec.paging }, refresh, restart);
      return acquired.promise
        .then((result) => {
          if (live && source === sourceVersion) {
            setState({ status: "ready", rows: result.rows, total: result.total ?? result.rows.length, source });
          }
        })
        .catch((error: unknown) => {
          if (live && source === sourceVersion) {
            const status = error instanceof DataError && error.status === 403 ? "forbidden" : "failed";
            setState({ status, rows: [], error: error instanceof Error ? error.message : String(error), source });
          }
        });
    };
    const timer = setTimeout(start, spec.debounce ?? 0);
    return () => {
      live = false;
      clearTimeout(timer);
      acquired?.release();
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [key, enabled, seen, nonce, source]);
  const visible = state.source === source ? state : { status: "loading" as const, rows: [], source };
  return { ...visible, params, refetch: (restart = false) => {
    restartNext.current ||= restart;
    setNonce((value) => value + 1);
  }};
}
//+bound

/** How many poll intervals a read may go unanswered before the poll gives it up. */
const STALLED = 5;

/**
 * Reads again every `every` milliseconds while mounted: a `live:` section's fallback, since no
 * served surface streams events.
 */
export function usePoll(read: ReadState, every: number): ReadState {
  const refetch = read.refetch;
  // A tick while the read is still in flight is skipped: starting another would drop its answer.
  // A read unanswered for `STALLED` intervals is given up (aborted) and read again.
  const busy = (value: ReadStatus) => value === "loading" || value === "refreshing";
  const status = useRef(read.status);
  // When the read in flight started: whatever started it, a refetch, a command or new params.
  const since = useRef(Date.now());
  if (busy(read.status) && !busy(status.current)) {
    since.current = Date.now();
  }
  status.current = read.status;
  useEffect(() => {
    const timer = setInterval(() => {
      const now = Date.now();
      if (!busy(status.current) || now - since.current >= every * STALLED) {
        since.current = now;
        refetch(busy(status.current));
      }
    }, every);
    // Outside a browser (node), a poll alone never keeps the process running.
    (timer as unknown as { unref?: () => void }).unref?.();
    return () => clearInterval(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [every]);
  return read;
}
//-bound

/** The signed-in actor, as `actor.<field>` reads it. */
export interface Actor {
  signed_in: boolean;
  user_id?: string;
  account_id?: string;
  roles: string[];
  may(command: string): boolean;
  [field: string]: unknown;
}

const anonymous: Actor = { signed_in: false, roles: [], may: () => false };

/** Resolves the actor: from the session view when `from_session`, anonymous otherwise. */
export function useActor(source: "from_session" | "anonymous"): { actor: Actor; ready: boolean } {
  const read = useRead(source === "from_session" ? { view: "session.Me" } : undefined, {});
  if (source !== "from_session") {
    return { actor: anonymous, ready: true };
  }
  const row = read.rows[0];
  if (read.status !== "ready" || !isObject(row)) {
    return { actor: anonymous, ready: read.status === "failed" || read.status === "forbidden" };
  }
  const roles = Array.isArray(row.roles) ? row.roles.map(String) : [];
  const organization = row.organization;
  return {
    ready: true,
    actor: {
      ...row,
      signed_in: true,
      user_id: typeof row.id === "string" ? row.id : undefined,
      account_id: isObject(organization) && typeof organization.id === "string" ? organization.id : undefined,
      roles,
      may: () => true,
    },
  };
}
