/** Any JSON value: what fixtures, reads and commands carry. */
export type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

/** A JSON object. */
export type JsonObject = { [key: string]: Json };

/** Whether a value is a plain object. */
export function isObject(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

/** A stable text form of a value, used as a cache and comparison key. */
export function stableKey(value: unknown): string {
  if (Array.isArray(value)) {
    return `[${value.map(stableKey).join(",")}]`;
  }
  if (isObject(value)) {
    return `{${Object.keys(value)
      .sort()
      .filter((key) => value[key] !== undefined && typeof value[key] !== "function")
      .map((key) => `${JSON.stringify(key)}:${stableKey(value[key])}`)
      .join(",")}}`;
  }
  if (value === undefined || typeof value === "function") {
    return "null";
  }
  return JSON.stringify(value);
}

/** Reads a dotted path out of a value. */
export function getPath(value: unknown, path: readonly string[]): unknown {
  let current: unknown = value;
  for (const segment of path) {
    if (Array.isArray(current) && segment !== "length") {
      current = current.map((entry) => getPath(entry, [segment]));
      continue;
    }
    if (!isObject(current) && !Array.isArray(current)) {
      return undefined;
    }
    current = (current as Record<string, unknown>)[segment];
  }
  return current;
}

/** A copy of `value` with `path` set to `next`. */
export function setPath(value: unknown, path: readonly string[], next: unknown): unknown {
  if (path.length === 0) {
    return next;
  }
  const [head, ...rest] = path;
  const base: Record<string, unknown> = isObject(value) ? { ...value } : {};
  base[head] = setPath(base[head], rest, next);
  return base;
}

/**
 * The tone a tone map gives `value`, or `fallback`. A map written out names exact values; a band
 * map, `{ bands: [{ from, tone }] }`, gives a number the tone of the last band whose `from` it
 * reaches, and a value that is no number, or below the first band, the fallback.
 */
export function toneFor(map: unknown, value: unknown, fallback: string): string {
  if (!isObject(map)) {
    return fallback;
  }
  if (Array.isArray(map.bands)) {
    if (typeof value !== "number" || Number.isNaN(value)) {
      return fallback;
    }
    let tone = fallback;
    for (const band of map.bands) {
      if (isObject(band) && typeof band.from === "number" && typeof band.tone === "string" && value >= band.from) {
        tone = band.tone;
      }
    }
    return tone;
  }
  const key = String(value);
  return Object.prototype.hasOwnProperty.call(map, key) && typeof map[key] === "string" ? (map[key] as string) : fallback;
}
