// Fields: a column or record field displayed, or a form field edited.

import { useState, type ChangeEvent, type ReactNode } from "react";
import { useUiPath } from "./core";
import { display, formatDuration, formatValue, safeUrl, ScopeLayer, useScope } from "./core";
import { useRead } from "./data";
import { evaluate, truthy } from "./expr";
import { getPath, isObject, stableKey } from "./json";

/** A field as the document declares it, with its node path. */
export interface FieldSpec {
  "data-ui-path": string;
  field: string;
  name: string;
  label?: string;
  as?: string;
  /** What an `as: duration` value counts; milliseconds when absent. */
  unit?: "ms" | "s";
  sortable?: boolean;
  visible?: string;
  binds?: string;
  note?: string;
  choice?: ReactNode;
  labelFrom?: LabelFrom;
  /** The text a column or record shows for a value, keyed by the value as text. */
  labels?: Record<string, string>;
  /** Help text or link shown with the input, or on its column header. */
  help?: HelpSpec;
}

/** Help text or link (`help: {text, link}`). */
export interface HelpSpec {
  text?: string;
  link?: string;
}

/** Help shown beside a group, an input or a column heading: its text, then its link. */
export function HelpNote(props: { help?: HelpSpec }): ReactNode {
  const help = props.help;
  if (!help || (!help.text && !help.link)) {
    return null;
  }
  return (
    <small className="ui-help">
      {help.text}
      {help.link ? (
        <>
          {help.text ? " " : null}
          <a href={help.link} target="_blank" rel="noreferrer">
            More
          </a>
        </>
      ) : null}
    </small>
  );
}

/** A field of a related view shown in place of a key: the row whose `key` (default `id`) equals it. */
export interface LabelFrom {
  view: string;
  field: string;
  key?: string;
}

/** The label `labelFrom` gives `value` among the related `rows`; the value itself when none matches. */
export function lookupLabel(rows: readonly unknown[], labelFrom: LabelFrom, value: unknown): unknown {
  const key = (labelFrom.key ?? "id").split(".");
  const related = rows.find((row) => String(getPath(row, key) ?? "") === String(value ?? ""));
  const label = related === undefined ? undefined : getPath(related, labelFrom.field.split("."));
  return label === undefined || label === null ? value : label;
}

/**
 * Reads each related view the fields label from, once, and returns how a row is shown: each
 * `labelFrom` field holds its label. Actions and the scope keep the row's own values.
 */
export function useLabelled(fields: readonly FieldSpec[]): (row: unknown) => unknown {
  const scope = useScope();
  const views = [...new Set(fields.flatMap((field) => (field.labelFrom ? [field.labelFrom.view] : [])))];
  const rows = new Map<string, readonly unknown[]>();
  for (const view of views) {
    // The views come from the document, so every render calls the same hooks in the same order.
    rows.set(view, useRead({ view }, scope.values).rows);
  }
  return (row) => {
    if (views.length === 0 || !isObject(row)) {
      return row;
    }
    const shown: Record<string, unknown> = { ...row };
    for (const field of fields) {
      if (field.labelFrom) {
        shown[field.field] = lookupLabel(rows.get(field.labelFrom.view) ?? [], field.labelFrom, row[field.field]);
      }
    }
    return shown;
  };
}

/** The heading of a field. */
export function fieldLabel(field: FieldSpec): string {
  return field.label ?? field.name.replace(/_/g, " ");
}

/** Whether a field is shown in the current scope. */
export function useFieldVisible(field: FieldSpec): boolean {
  const scope = useScope();
  return field.visible === undefined || truthy(evaluate(field.visible, scope.values));
}

/** The label `labels` gives `value`: a string, number or boolean keyed by its text; `undefined` when none. */
export function valueLabel(labels: Readonly<Record<string, string>> | undefined, value: unknown): string | undefined {
  if (labels === undefined || !["string", "number", "boolean"].includes(typeof value)) {
    return undefined;
  }
  const key = String(value);
  return Object.prototype.hasOwnProperty.call(labels, key) ? labels[key] : undefined;
}

/** A field's value in a row, rendered by its `as`. */
export function FieldValue(props: { field: FieldSpec; row: unknown }): ReactNode {
  const { field } = props;
  const value = display(props.row, field.field);
  let content: ReactNode;
  switch (field.as) {
    case "badge":
    case "choice":
      content = <span className={`ui-badge ui-badge-${String(value)}`}>{valueLabel(field.labels, value) ?? formatValue(value)}</span>;
      break;
    case "tags":
      content = (Array.isArray(value) ? value : []).map((tag, index) => (
        <span key={`${index}:${stableKey(tag)}`} className="ui-tag">
          {tagText(tag)}
        </span>
      ));
      break;
    case "audio": {
      const src = safeUrl(value);
      content = src === undefined ? formatValue(value) : <audio controls preload="none" src={src} />;
      break;
    }
    case "link": {
      const href = safeUrl(value);
      const text = valueLabel(field.labels, value) ?? formatValue(value);
      content =
        href === undefined ? (
          text
        ) : (
          <a href={href} target="_blank" rel="noreferrer">
            {text}
          </a>
        );
      break;
    }
    case "duration":
      content =
        valueLabel(field.labels, value) ??
        (typeof value === "number" ? formatDuration(value, field.unit) : formatValue(value));
      break;
    case "json":
      content = <pre className="ui-json">{JSON.stringify(value, null, 2)}</pre>;
      break;
    case "secret":
      content = "••••••••";
      break;
    case "toggle":
      // A read-only switch: the value as on or off, named by its column.
      content = <input type="checkbox" checked={truthy(value)} disabled aria-label={fieldLabel(field)} />;
      break;
    default:
      content = valueLabel(field.labels, value) ?? formatValue(value, field.as);
  }
  return (
    <span className={`ui-field ui-field-${field.as ?? "text"}`} data-ui-path={useUiPath(field["data-ui-path"])}>
      {content}
    </span>
  );
}

/** The text of one tag: an object's `label`, other data as JSON, a scalar as itself. */
function tagText(tag: unknown): string {
  if (isObject(tag) && tag.label !== undefined && tag.label !== null) {
    return String(tag.label);
  }
  return typeof tag === "object" && tag !== null ? JSON.stringify(tag) : String(tag);
}

/**
 * A JSON field: the text as written, the parsed value sent. Unparsable text is refused at the
 * field (marked invalid, a validity message that stops the form's submit) and never sent.
 */
function JsonInput(props: { value: unknown; set: (next: unknown) => void }): ReactNode {
  const [written, setWritten] = useState<string | undefined>(undefined);
  const [error, setError] = useState<string | undefined>(undefined);
  const text =
    written ?? (props.value === undefined || props.value === null ? "" : JSON.stringify(props.value, null, 2));
  return (
    <>
      <textarea
        rows={6}
        value={text}
        aria-invalid={error !== undefined}
        ref={(element: HTMLTextAreaElement | null) => {
          element?.setCustomValidity(error ?? "");
        }}
        onChange={(event: ChangeEvent<HTMLTextAreaElement>) => {
          const next = event.target.value;
          setWritten(next);
          if (next.trim() === "") {
            setError(undefined);
            props.set(undefined);
            return;
          }
          try {
            props.set(JSON.parse(next));
            setError(undefined);
          } catch (caught) {
            setError(`not valid JSON: ${caught instanceof Error ? caught.message : String(caught)}`);
          }
        }}
      />
      {error !== undefined ? (
        <small className="ui-field-error" role="alert">
          {error}
        </small>
      ) : null}
    </>
  );
}

/** A list field: one input per entry, each with a remove button, and a button that adds one. */
function ListInput(props: { value: unknown; set: (next: unknown) => void; label: string }): ReactNode {
  const entries: unknown[] = Array.isArray(props.value) ? props.value : [];
  return (
    <span className="ui-list-input">
      {entries.map((entry, index) => (
        <span key={index} className="ui-list-entry">
          <input
            aria-label={`${props.label} ${index + 1}`}
            value={entry === undefined || entry === null ? "" : typeof entry === "object" ? JSON.stringify(entry) : String(entry)}
            onChange={(event: ChangeEvent<HTMLInputElement>) =>
              props.set(entries.map((old, at) => (at === index ? event.target.value : old)))
            }
          />
          <button
            type="button"
            aria-label={`Remove ${props.label} ${index + 1}`}
            onClick={() => props.set(entries.filter((_, at) => at !== index))}
          >
            ×
          </button>
        </span>
      ))}
      <button type="button" aria-label={`Add ${props.label}`} onClick={() => props.set([...entries, ""])}>
        Add
      </button>
    </span>
  );
}

/** A field edited in a form; it writes to `binds`, or to `draft.<field>`. */
export function FieldInput(props: { field: FieldSpec }): ReactNode {
  const { field } = props;
  const scope = useScope();
  const visible = useFieldVisible(field);
  if (!visible) {
    return null;
  }
  const target = field.binds ?? `draft.${field.field}`;
  const value = evaluate(target, scope.values);
  const set = (next: unknown) => scope.set(target, next);
  const text = value === undefined || value === null || typeof value === "object" ? "" : String(value);
  let control: ReactNode;
  switch (field.as) {
    case "choice":
      control = field.choice ? (
        <ScopeLayer actions={{ pick: (next: unknown) => set(next) }}>{field.choice}</ScopeLayer>
      ) : (
        <input value={text} onChange={(event: ChangeEvent<HTMLInputElement>) => set(event.target.value)} />
      );
      break;
    case "number":
      control = (
        <input
          type="number"
          value={text}
          onChange={(event: ChangeEvent<HTMLInputElement>) =>
            set(event.target.value === "" ? null : Number(event.target.value))
          }
        />
      );
      break;
    case "date":
    case "time":
      control = (
        <input
          type={field.as === "date" ? "date" : "datetime-local"}
          value={text}
          onChange={(event: ChangeEvent<HTMLInputElement>) => set(event.target.value)}
        />
      );
      break;
    case "toggle":
      control = (
        <input
          type="checkbox"
          checked={truthy(value)}
          onChange={(event: ChangeEvent<HTMLInputElement>) => set(event.target.checked)}
        />
      );
      break;
    case "secret":
      control = (
        <input type="password" value={text} onChange={(event: ChangeEvent<HTMLInputElement>) => set(event.target.value)} />
      );
      break;
    case "rich_text":
      control = (
        <textarea rows={4} value={text} onChange={(event: ChangeEvent<HTMLTextAreaElement>) => set(event.target.value)} />
      );
      break;
    case "json":
      control = <JsonInput value={value} set={set} />;
      break;
    case "list":
      control = <ListInput value={value} set={set} label={fieldLabel(field)} />;
      break;
    case "tags":
      control = (
        <input
          value={Array.isArray(value) ? value.join(", ") : text}
          placeholder="comma, separated"
          onChange={(event: ChangeEvent<HTMLInputElement>) =>
            set(
              event.target.value
                .split(",")
                .map((tag) => tag.trim())
                .filter((tag) => tag.length > 0),
            )
          }
        />
      );
      break;
    case "file":
      control = (
        <input
          type="file"
          onChange={(event: ChangeEvent<HTMLInputElement>) => set(event.target.files?.[0]?.name ?? null)}
        />
      );
      break;
    default:
      control = (
        <input
          type={field.as === "search" ? "search" : "text"}
          value={text}
          onChange={(event: ChangeEvent<HTMLInputElement>) => set(event.target.value)}
        />
      );
  }
  return (
    <label className="ui-form-field" data-ui-path={useUiPath(field["data-ui-path"])}>
      <span className="ui-form-label">{fieldLabel(field)}</span>
      {control}
      {field.note ? <small className="ui-note">{field.note}</small> : null}
      <HelpNote help={field.help} />
    </label>
  );
}

/** A tab of a record or form. */
export interface TabSpec {
  "data-ui-path": string;
  name: string;
  label?: string;
  visible?: string;
  fields?: FieldSpec[];
  content?: ReactNode;
}

/** Tabs: one panel shown at a time. */
export function Tabs(props: { tabs: TabSpec[]; panel: (tab: TabSpec) => ReactNode }): ReactNode {
  const scope = useScope();
  const shown = props.tabs.filter((tab) => tab.visible === undefined || truthy(evaluate(tab.visible, scope.values)));
  const [active, setActive] = useState(shown[0]?.name);
  const current = shown.find((tab) => tab.name === active) ?? shown[0];
  return (
    <div className="ui-tabs">
      <div role="tablist">
        {shown.map((tab) => (
          <button
            key={tab.name}
            type="button"
            role="tab"
            aria-selected={tab.name === current?.name}
            className="ui-tab"
            onClick={() => setActive(tab.name)}
          >
            {tab.label ?? tab.name}
          </button>
        ))}
      </div>
      {current ? (
        <div role="tabpanel" data-ui-path={useUiPath(current["data-ui-path"])}>
          {props.panel(current)}
        </div>
      ) : null}
    </div>
  );
}

