:root {
  font-family: var(--ui-type-body-family);
  color: var(--ui-color-text);
  background: var(--ui-color-bg);
}

body { margin: 0; }
h1 { font-size: var(--ui-size-text-title); margin: 0; }
h2 { font-size: var(--ui-type-heading-size); margin: 0 0 var(--ui-space-sm); }
h3 { font-size: var(--ui-size-text-subtitle); margin: var(--ui-size-gap-wide) 0 var(--ui-space-xs); }

.ui-shell { display: grid; grid-template-columns: var(--ui-size-nav-width) 1fr; align-content: start; min-height: var(--ui-size-viewport-height); }
.ui-shell > .ui-region { grid-column: 2; }
.ui-shell > .ui-region-navigation { grid-column: 1; grid-row: 1 / span 8; background: var(--ui-color-surface); border-right: var(--ui-size-hairline) solid var(--ui-color-line); padding: var(--ui-space-md); }
.ui-region-account_menu, .ui-region-assistant { justify-self: end; padding: var(--ui-space-sm) var(--ui-space-md); }
.ui-region-page_outlet { padding: var(--ui-space-md) var(--ui-space-lg); min-width: 0; }
.ui-region-notifications { position: fixed; right: var(--ui-space-md); bottom: var(--ui-space-md); z-index: 30; }

.ui-nav ul { list-style: none; margin: 0 0 var(--ui-space-md); padding: 0; }
.ui-nav a { display: block; padding: var(--ui-space-xs) var(--ui-space-sm); color: inherit; text-decoration: none; border-radius: var(--ui-radius-sm); }
.ui-nav a:hover { background: var(--ui-color-bg); }
.ui-nav-search { width: 100%; margin-bottom: var(--ui-space-md); }
.ui-collapsed .ui-nav-section { display: none; }

.ui-page { display: flex; flex-direction: column; gap: var(--ui-space-md); }
.ui-header { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-size-gap-wide); }
.ui-header-title { display: flex; align-items: baseline; gap: var(--ui-space-sm); flex: 1; }
.ui-header-actions, .ui-header-metrics, .ui-switch { display: flex; gap: var(--ui-space-sm); }
.ui-total { color: var(--ui-color-muted); }
.ui-live { font-size: var(--ui-size-text-small); padding: var(--ui-size-pad-hair) var(--ui-size-pad-cell); border-radius: var(--ui-radius-pill); background: var(--ui-color-line); }
.ui-live[data-lifecycle="live"] { background: var(--ui-color-success_fill); }
.ui-live[data-lifecycle="reconnecting"], .ui-live[data-lifecycle="stale"] { background: var(--ui-color-warning_fill); }
.ui-help { color: var(--ui-color-muted); width: 100%; margin: 0; }
th .ui-help, .ui-form-field .ui-help, .ui-form-group > .ui-help { display: block; font-weight: var(--ui-size-text-weight-regular); }

.ui-layout-stack { display: flex; flex-direction: column; gap: var(--ui-space-md); }
.ui-layout-columns { display: flex; gap: var(--ui-space-md); align-items: flex-start; }
.ui-column { display: flex; flex-direction: column; gap: var(--ui-space-md); min-width: 0; flex: 2; }
.ui-column-narrow { flex: 1; }
.ui-column-wide { flex: 3; }
.ui-layout-areas { display: grid; gap: var(--ui-space-md); }
.ui-area { display: flex; flex-direction: column; gap: var(--ui-space-md); min-width: 0; }

.ui-section { position: relative; min-width: 0; background: var(--ui-color-surface); border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-lg); padding: var(--ui-space-md); }
.ui-dim { opacity: 0.6; }
.ui-stale-badge, .ui-new-count { position: absolute; top: var(--ui-space-sm); right: var(--ui-space-sm); font-size: var(--ui-size-text-tiny); padding: var(--ui-size-pad-hair) var(--ui-size-pad-cell); border-radius: var(--ui-radius-pill); background: var(--ui-color-warning_fill); }
.ui-new-count { right: var(--ui-size-new-count-offset); background: var(--ui-color-info_fill); }
.ui-skeleton div { height: var(--ui-size-fade-depth); margin: var(--ui-space-sm) 0; border-radius: var(--ui-radius-sm); background: linear-gradient(90deg, var(--ui-color-line), var(--ui-color-bg), var(--ui-color-line)); }
.ui-spinner { width: var(--ui-space-lg); height: var(--ui-space-lg); border: var(--ui-size-spinner-stroke) solid var(--ui-color-line); border-top-color: var(--ui-color-accent); border-radius: var(--ui-fixed-radius-round); animation: ui-spin 1s linear infinite; }
@keyframes ui-spin { to { transform: rotate(360deg); } }
.ui-state { color: var(--ui-color-muted); }
.ui-state-failed { color: var(--ui-color-danger); }

.ui-button { font: inherit; padding: var(--ui-size-gap-tight) var(--ui-size-gap-wide); border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-md); background: var(--ui-color-surface); cursor: pointer; }
.ui-button:disabled { opacity: 0.5; cursor: default; }
.ui-icon-button { padding: var(--ui-space-xs) var(--ui-space-sm); }
.ui-emphasis-primary { background: var(--ui-color-accent); border-color: var(--ui-color-accent); color: var(--ui-color-on_accent); }
.ui-emphasis-danger { background: var(--ui-color-danger); border-color: var(--ui-color-danger); color: var(--ui-color-on_accent); }
.ui-emphasis-ghost { border-color: var(--ui-fixed-transparent); background: var(--ui-fixed-transparent); }
.ui-upload input { display: none; }
.ui-link, .ui-menu-item { color: var(--ui-color-accent); }
.ui-menu { list-style: none; position: absolute; margin: 0; padding: var(--ui-space-xs); background: var(--ui-color-surface); border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-md); z-index: 20; }
.ui-menu .ui-menu-item { background: none; border: 0; font: inherit; padding: var(--ui-size-gap-tight) var(--ui-size-gap-wide); cursor: pointer; }

.ui-table-frame { overflow-x: auto; max-width: 100%; background: linear-gradient(to right, var(--ui-color-surface) 30%, var(--ui-fixed-transparent)) left center / var(--ui-size-fade-width) 100% no-repeat local, linear-gradient(to left, var(--ui-color-surface) 30%, var(--ui-fixed-transparent)) right center / var(--ui-size-fade-width) 100% no-repeat local, radial-gradient(farthest-side at 0 50%, color-mix(in srgb, var(--ui-color-backdrop) 66.667%, var(--ui-fixed-transparent)), var(--ui-fixed-transparent)) left center / var(--ui-size-fade-depth) 100% no-repeat scroll, radial-gradient(farthest-side at 100% 50%, color-mix(in srgb, var(--ui-color-backdrop) 66.667%, var(--ui-fixed-transparent)), var(--ui-fixed-transparent)) right center / var(--ui-size-fade-depth) 100% no-repeat scroll; }
.ui-table { width: 100%; border-collapse: collapse; }
.ui-table th, .ui-table td { text-align: left; padding: var(--ui-size-pad-cell) var(--ui-space-sm); border-bottom: var(--ui-size-hairline) solid var(--ui-color-line); vertical-align: top; }
.ui-actions-head, .ui-actions-cell { white-space: nowrap; }
.ui-row-controls { display: flex; gap: var(--ui-size-gap-tight); align-items: center; }
.ui-actions-cell .ui-row-actions, .ui-actions-cell .ui-move { display: inline-flex; flex-wrap: nowrap; vertical-align: middle; }
.ui-expand-toggle { line-height: var(--ui-fixed-line-height-tight); }
.ui-drag-handle { cursor: grab; user-select: none; padding: 0 var(--ui-space-xs); color: var(--ui-color-muted); }
.ui-collection-tools, .ui-bulk-menu { display: flex; flex-wrap: wrap; gap: var(--ui-space-sm); align-items: center; margin-bottom: var(--ui-space-sm); }
.ui-sort-control, .ui-select-all-label { display: flex; gap: var(--ui-size-gap-tight); align-items: center; }
.ui-bulk-count { color: var(--ui-color-muted); }
.ui-sort { font: inherit; font-weight: var(--ui-type-heading-weight); background: none; border: 0; padding: 0; cursor: pointer; }
.ui-focused { background: var(--ui-color-focus); }
.ui-collection-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(var(--ui-size-card-min-width), 100%), 1fr)); gap: var(--ui-size-gap-wide); list-style: none; padding: 0; margin: 0; }
.ui-card { display: flex; flex-direction: column; gap: var(--ui-space-sm); min-width: 0; border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-lg); padding: var(--ui-size-gap-wide); }
.ui-row-body { min-width: 0; overflow-wrap: anywhere; }
.ui-row-tail { display: flex; flex-wrap: wrap; gap: var(--ui-size-gap-tight); align-items: center; }
.ui-collection-list { list-style: none; padding: 0; margin: 0; }
.ui-list-item { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--ui-space-sm); padding: var(--ui-space-sm) 0; border-bottom: var(--ui-size-hairline) solid var(--ui-color-line); }
.ui-list-item > .ui-row-body { flex: 1 1 var(--ui-size-row-body-basis); }
.ui-list-item > .ui-expand { flex-basis: 100%; }
.ui-row-actions, .ui-collection-actions, .ui-form-actions, .ui-record-actions, .ui-toolbar { display: flex; gap: var(--ui-size-gap-tight); flex-wrap: wrap; }
.ui-pager { display: flex; gap: var(--ui-space-sm); align-items: center; margin-top: var(--ui-size-gap-wide); }
dl { margin: 0; }
dt { font-size: var(--ui-size-text-small); color: var(--ui-color-muted); }
dd { margin: 0 0 var(--ui-space-sm); }

.ui-badge { display: inline-block; font-size: var(--ui-size-text-small); padding: var(--ui-size-pad-hair) var(--ui-size-pad-badge); border-radius: var(--ui-radius-pill); background: var(--ui-tone-neutral-fill); }
.ui-tone-neutral { color: var(--ui-tone-neutral-text); }
.ui-tone-info { color: var(--ui-tone-info-text); }
.ui-tone-success { color: var(--ui-tone-success-text); }
.ui-tone-warning { color: var(--ui-tone-warning-text); }
.ui-tone-danger { color: var(--ui-tone-danger-text); }
.ui-badge.ui-tone-neutral { background: var(--ui-tone-neutral-fill); }
.ui-badge.ui-tone-info { background: var(--ui-tone-info-fill); }
.ui-badge.ui-tone-success { background: var(--ui-tone-success-fill); }
.ui-badge.ui-tone-warning { background: var(--ui-tone-warning-fill); }
.ui-badge.ui-tone-danger, .ui-notice.ui-tone-danger { background: var(--ui-tone-danger-fill); color: var(--ui-tone-danger-text); }
.ui-field-tone-info { color: var(--ui-tone-info-text); }
.ui-field-tone-success { color: var(--ui-tone-success-text); }
.ui-field-tone-warning { color: var(--ui-tone-warning-text); }
.ui-field-tone-danger { color: var(--ui-tone-danger-text); }
.ui-tag, .ui-chip { display: inline-block; margin: 0 var(--ui-space-xs) var(--ui-space-xs) 0; padding: var(--ui-size-pad-hair) var(--ui-space-sm); border-radius: var(--ui-radius-pill); border: var(--ui-size-hairline) solid var(--ui-color-line); background: var(--ui-color-surface); font: inherit; font-size: var(--ui-type-caption-size); }
.ui-tag-suggestions { display: block; margin-top: var(--ui-space-xs); }
.ui-tag-suggestion { cursor: pointer; color: var(--ui-color-muted, inherit); }
.ui-chip { cursor: pointer; }
.ui-chip-on { background: var(--ui-color-accent); border-color: var(--ui-color-accent); color: var(--ui-color-on_accent); }
.ui-text-heading { font-weight: var(--ui-type-heading-weight); font-size: var(--ui-type-heading-size); }
.ui-text-caption { font-size: var(--ui-type-caption-size); color: var(--ui-color-muted); }
.ui-text-mono { font-family: var(--ui-type-mono-family); }
.ui-image { max-width: 100%; max-height: var(--ui-size-image-max-height); }
.ui-divider { border: 0; border-top: var(--ui-size-hairline) solid var(--ui-color-line); width: 100%; }
.ui-icon::before { content: "●"; }
.ui-widget { display: flex; gap: var(--ui-space-sm); }
.ui-arrange-column { flex-direction: column; }
.ui-arrange-row { flex-direction: row; align-items: center; }
.ui-arrange-grid { display: grid; grid-template-columns: repeat(2, 1fr); }

.ui-filter-bar { display: flex; flex-wrap: wrap; gap: var(--ui-space-sm); align-items: center; }
.ui-form { display: flex; flex-direction: column; gap: var(--ui-size-gap-wide); }
.ui-form-field { display: flex; flex-direction: column; gap: var(--ui-space-xs); }
.ui-form-label { font-size: var(--ui-type-caption-size); color: var(--ui-color-muted); }
.ui-form-group { border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-md); display: flex; flex-direction: column; gap: var(--ui-space-sm); }
.ui-note { color: var(--ui-color-muted); }
input, select, textarea { font: inherit; padding: var(--ui-size-pad-snug) var(--ui-space-sm); border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-md); }
.ui-tabs [role="tablist"] { display: flex; gap: var(--ui-space-xs); border-bottom: var(--ui-size-hairline) solid var(--ui-color-line); margin-bottom: var(--ui-space-sm); }
.ui-tab { font: inherit; background: none; border: 0; padding: var(--ui-size-gap-tight) var(--ui-size-gap-wide); cursor: pointer; }
.ui-tab[aria-selected="true"] { border-bottom: var(--ui-size-hairline-thick) solid var(--ui-color-accent); }

.ui-metric { display: flex; flex-direction: column; }
.ui-metric-value { font-size: var(--ui-size-text-metric); font-weight: var(--ui-type-heading-weight); }
.ui-metric-label { color: var(--ui-color-muted); font-size: var(--ui-type-caption-size); }
.ui-bars { display: flex; align-items: flex-end; gap: var(--ui-size-gap-wide); height: var(--ui-size-chart-height); }
.ui-bar-group { display: flex; align-items: flex-end; justify-content: center; gap: var(--ui-size-hairline-thick); height: 100%; position: relative; padding-bottom: var(--ui-size-chart-label-room); flex: 1 1 0; min-width: 0; }
.ui-bar { width: var(--ui-space-md); background: var(--ui-color-accent); }
.ui-bar.ui-series-1 { background: var(--ui-color-info); opacity: 0.6; }
.ui-bar-group > .ui-chart-x-label { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; }
.ui-chart-x { display: flex; }
.ui-chart-x-slot { flex: 1 1 0; min-width: 0; text-align: center; }
.ui-chart-x-label { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--ui-size-text-tiny); }
.ui-chart-legend { list-style: none; margin: var(--ui-space-xs) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ui-size-gap-wide); font-size: var(--ui-type-caption-size); }
.ui-legend-item { display: flex; align-items: center; gap: var(--ui-size-pad-snug); }
.ui-swatch { width: var(--ui-size-swatch); height: var(--ui-size-swatch); border-radius: var(--ui-size-hairline-thick); background: var(--ui-color-accent); }
.ui-swatch.ui-series-1 { background: var(--ui-color-info); opacity: 0.6; }
.ui-chart-svg { width: 100%; height: var(--ui-size-chart-height); }
.ui-chart-svg polyline { stroke: var(--ui-color-accent); stroke-width: var(--ui-fixed-chart-stroke); }
.ui-chart-svg polyline.ui-series-1 { stroke: var(--ui-color-info); stroke-dasharray: var(--ui-fixed-chart-dash); }
.ui-board { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--ui-size-gap-wide); }
.ui-board-stack { display: flex; flex-direction: column; }
.ui-board-item { border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-md); padding: var(--ui-space-sm); }
.ui-graph-nodes, .ui-graph-edges { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ui-space-sm); }
.ui-graph-node { border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-md); padding: var(--ui-space-sm); display: flex; flex-direction: column; gap: var(--ui-space-xs); }

.ui-overlay-backdrop { position: fixed; inset: 0; background: var(--ui-color-backdrop); display: flex; z-index: 10; }
.ui-backdrop-drawer { justify-content: flex-end; }
.ui-backdrop-dialog, .ui-backdrop-popover { align-items: center; justify-content: center; }
.ui-overlay { background: var(--ui-color-surface); padding: var(--ui-space-md); overflow: auto; }
.ui-overlay-drawer { width: min(var(--ui-size-drawer-width), 100%); height: 100%; }
.ui-overlay-dialog, .ui-overlay-popover { width: min(var(--ui-size-dialog-width), 100%); border-radius: var(--ui-radius-lg); }
.ui-overlay-fullscreen { width: 100%; height: 100%; }
.ui-overlay-head { display: flex; justify-content: space-between; align-items: center; }

.ui-notifications { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--ui-space-sm); }
.ui-notice { background: var(--ui-color-surface); border: var(--ui-size-hairline) solid var(--ui-color-line); border-radius: var(--ui-radius-md); padding: var(--ui-space-sm) var(--ui-size-gap-wide); }
