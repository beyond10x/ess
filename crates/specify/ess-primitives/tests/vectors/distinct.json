{
  "about": "Distinct list members, {distinct: {in: <list>, as: <binder>, by: <binder>.<member>, kind: <key kind>}} (docs/design/expression-family-source22.md, `distinct`). Each `evaluate` row is a canonical predicate over one row and the truth every lane answers; `refused` documents no reader reads; `unkinded` documents a source reader reads before its key kind is resolved and every suite reader refuses. Each lane holds its faulty variants (adjacent pairs only, `by` ignored, spellings compared, Unknown read as distinct, a shared null for absent keys, binary64 integers, lexical decimals, instants for text, any list of two accepted) to disagree with at least one row. Answered by ess-primitives tests/distinct.rs, the Go fixture ess-conformance/tests/fixtures/distinct.go and ess-conformance/src/ts/predicate.test.ts.",
  "evaluate": [
    {"name": "an empty list is distinct", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": []}, "truth": "true"},
    {"name": "one element is distinct", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["a"]}, "truth": "true"},
    {"name": "one absent element is distinct", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": [null]}, "truth": "true"},
    {"name": "two different values", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["a", "b"]}, "truth": "true"},
    {"name": "two equal values", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["a", "a"]}, "truth": "false"},
    {"name": "a duplicate that is not adjacent", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["a", "b", "a"]}, "truth": "false"},
    {"name": "the first and the last are equal", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["a", "b", "c", "a"]}, "truth": "false"},
    {"name": "reordered distinct values", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["c", "a", "b"]}, "truth": "true"},
    {"name": "an absent key beside a known one is unknown", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": [null, "a"]}, "truth": "unknown"},
    {"name": "two absent keys are not one shared null", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": [null, null]}, "truth": "unknown"},
    {"name": "a known duplicate dominates an absent key", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["a", null, "a"]}, "truth": "false"},
    {"name": "an unobserved list is unknown", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {}, "truth": "unknown"},
    {"name": "an absent optional list is unknown, not empty", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": null}, "truth": "unknown"},
    {"name": "negation of a duplicate", "predicate": {"not": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}}, "row": {"tags": ["a", "a"]}, "truth": "true"},
    {"name": "negation keeps unknown", "predicate": {"not": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}}, "row": {"tags": ["a", null]}, "truth": "unknown"},
    {"name": "text compares exactly, case and all", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tags": ["a", "A"]}, "truth": "true"},
    {"name": "a struct list by one member", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file.path", "kind": "string"}}, "row": {"files": [{"path": "a", "size": 1}, {"path": "b", "size": 1}]}, "truth": "true"},
    {"name": "a struct list by one member ignores the others", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file.path", "kind": "string"}}, "row": {"files": [{"path": "a", "size": 1}, {"path": "a", "size": 2}]}, "truth": "false"},
    {"name": "a struct list with a nonadjacent duplicate member", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file.path", "kind": "string"}}, "row": {"files": [{"path": "a", "size": 1}, {"path": "b", "size": 2}, {"path": "a", "size": 3}]}, "truth": "false"},
    {"name": "an absent key member is unknown", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file.path", "kind": "string"}}, "row": {"files": [{"path": "a", "size": 1}, {"size": 2}]}, "truth": "unknown"},
    {"name": "an absent key member is unknown, not a root field of the binder's name", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file.path", "kind": "string"}}, "row": {"file": {"path": "outer"}, "files": [{"size": 1}, {"path": "outer"}]}, "truth": "unknown"},
    {"name": "a root field of the binder's name is not an element", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "row": {"tag": "a", "tags": ["a", null]}, "truth": "unknown"},
    {"name": "a nested key member", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file.meta.path", "kind": "string"}}, "row": {"files": [{"meta": {"path": "a"}}, {"meta": {"path": "a"}}]}, "truth": "false"},
    {"name": "one instant spelled two ways is a duplicate", "predicate": {"distinct": {"in": "at", "as": "t", "kind": "timestamp"}}, "row": {"at": ["2020-01-01T00:00:00Z", "2019-12-31T19:00:00-05:00"]}, "truth": "false"},
    {"name": "a zero fraction is the same instant", "predicate": {"distinct": {"in": "at", "as": "t", "kind": "timestamp"}}, "row": {"at": ["2020-01-01T00:00:00.000Z", "2020-01-01T00:00:00Z"]}, "truth": "false"},
    {"name": "two instants a nanosecond apart", "predicate": {"distinct": {"in": "at", "as": "t", "kind": "timestamp"}}, "row": {"at": ["2020-01-01T00:00:00.000000001Z", "2020-01-01T00:00:00Z"]}, "truth": "true"},
    {"name": "the same spellings as text stay distinct", "predicate": {"distinct": {"in": "at", "as": "t", "kind": "string"}}, "row": {"at": ["2020-01-01T00:00:00Z", "2019-12-31T19:00:00-05:00"]}, "truth": "true"},
    {"name": "a timestamp no instant spells is unknown", "predicate": {"distinct": {"in": "at", "as": "t", "kind": "timestamp"}}, "row": {"at": ["yesterday", "2020-01-01T00:00:00Z"]}, "truth": "unknown"},
    {"name": "decimal one and one point zero are a duplicate", "predicate": {"distinct": {"in": "amounts", "as": "amount", "kind": "decimal"}}, "row": {"amounts": [1, 1.0]}, "truth": "false"},
    {"name": "decimal trailing zeroes are a duplicate", "predicate": {"distinct": {"in": "amounts", "as": "amount", "kind": "decimal"}}, "row": {"amounts": [1.5, 1.50]}, "truth": "false"},
    {"name": "decimals that differ", "predicate": {"distinct": {"in": "amounts", "as": "amount", "kind": "decimal"}}, "row": {"amounts": [1.5, 1.05]}, "truth": "true"},
    {"name": "integers past 2^53 stay distinct", "predicate": {"distinct": {"in": "ids", "as": "id", "kind": "integer"}}, "row": {"ids": [9007199254740992, 9007199254740993]}, "truth": "true"},
    {"name": "equal integers past 2^53", "predicate": {"distinct": {"in": "ids", "as": "id", "kind": "integer"}}, "row": {"ids": [9007199254740993, 9007199254740993]}, "truth": "false"},
    {"name": "a fraction is no integer key", "predicate": {"distinct": {"in": "ids", "as": "id", "kind": "integer"}}, "row": {"ids": [1, 1.5]}, "truth": "unknown"},
    {"name": "a text is no integer key", "predicate": {"distinct": {"in": "ids", "as": "id", "kind": "integer"}}, "row": {"ids": [1, "2"]}, "truth": "unknown"},
    {"name": "two booleans", "predicate": {"distinct": {"in": "flags", "as": "flag", "kind": "boolean"}}, "row": {"flags": [false, true]}, "truth": "true"},
    {"name": "three booleans hold a duplicate", "predicate": {"distinct": {"in": "flags", "as": "flag", "kind": "boolean"}}, "row": {"flags": [false, true, false]}, "truth": "false"},
    {"name": "enum variants compare as text", "predicate": {"distinct": {"in": "states", "as": "state", "kind": "enum"}}, "row": {"states": ["Open", "Closed"]}, "truth": "true"},
    {"name": "a repeated enum variant", "predicate": {"distinct": {"in": "states", "as": "state", "kind": "enum"}}, "row": {"states": ["Open", "Open"]}, "truth": "false"},
    {"name": "uuids compare as text", "predicate": {"distinct": {"in": "refs", "as": "ref", "kind": "uuid"}}, "row": {"refs": ["00000000-0000-4000-8000-000000000001", "00000000-0000-4000-8000-000000000001"]}, "truth": "false"},
    {"name": "inside a quantifier body", "predicate": {"forall": {"in": "groups", "as": "group", "that": {"distinct": {"in": "group.members", "as": "member", "by": "member.name", "kind": "string"}}}}, "row": {"groups": [{"members": [{"name": "a"}, {"name": "b"}]}, {"members": [{"name": "c"}, {"name": "c"}]}]}, "truth": "false"},
    {"name": "inside a quantifier body, every group distinct", "predicate": {"forall": {"in": "groups", "as": "group", "that": {"distinct": {"in": "group.members", "as": "member", "by": "member.name", "kind": "string"}}}}, "row": {"groups": [{"members": [{"name": "a"}, {"name": "b"}]}, {"members": [{"name": "a"}]}]}, "truth": "true"},
    {"name": "beside another leaf", "predicate": {"all": [{"distinct": {"in": "tags", "as": "tag", "kind": "string"}}, "count >= 1"]}, "row": {"tags": ["a", "b"], "count": 1}, "truth": "true"}
  ],
  "refused": [
    {"name": "no binder", "predicate": {"distinct": {"in": "tags", "as": 5, "kind": "string"}}},
    {"name": "a dotted binder", "predicate": {"distinct": {"in": "tags", "as": "tag.name", "kind": "string"}}},
    {"name": "no list", "predicate": {"distinct": {"as": "tag", "kind": "string"}}},
    {"name": "a list that is no path", "predicate": {"distinct": {"in": "not a path", "as": "tag", "kind": "string"}}},
    {"name": "a body", "predicate": {"distinct": {"in": "tags", "as": "tag", "that": "tag == a", "kind": "string"}}},
    {"name": "an extra key", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "string", "unique": true}}},
    {"name": "a key not under the binder", "predicate": {"distinct": {"in": "files", "as": "file", "by": "other.path", "kind": "string"}}},
    {"name": "a key that is the binder itself", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file", "kind": "string"}}},
    {"name": "an unknown key kind", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": "json"}}},
    {"name": "a key kind that is no text", "predicate": {"distinct": {"in": "tags", "as": "tag", "kind": true}}},
    {"name": "a key that is no text", "predicate": {"distinct": {"in": "files", "as": "file", "kind": "string", "by": 5}}}
  ],
  "unkinded": [
    {"name": "a scalar list without a kind", "predicate": {"distinct": {"in": "tags", "as": "tag"}}},
    {"name": "a struct list without a kind", "predicate": {"distinct": {"in": "files", "as": "file", "by": "file.path"}}}
  ]
}
