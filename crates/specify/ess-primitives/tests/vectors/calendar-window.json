{
  "about": "A calendar window over an instant in UTC or a fixed offset, {window: {at, days, from, to, offset}} (docs/design/calendar-window-guards.md). Each `evaluate` row is the predicate {window: <window>} over the row {t: <t>}, the window's `at` being `t`; a null `t` is unobserved. `refused` windows are refused by every reader; `canonical` windows are written back as `canonical`. 2020-01-06 is a Monday. Answered by tests/calendar_window.rs, the Go fixture ess-conformance/tests/fixtures/calendar-window.go and ess-conformance/src/ts/predicate.test.ts.",
  "evaluate": [
    {"name": "from is inclusive", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-06T07:00:00Z", "truth": "true"},
    {"name": "a second before from is outside", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-06T06:59:59Z", "truth": "false"},
    {"name": "a second before to is inside", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-09T14:59:59Z", "truth": "true"},
    {"name": "to is exclusive", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-09T15:00:00Z", "truth": "false"},
    {"name": "a fraction before to is inside", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-09T14:59:59.999Z", "truth": "true"},
    {"name": "a fraction after to is outside", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-09T15:00:00.001Z", "truth": "false"},
    {"name": "an unlisted day at from is outside", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-10T07:00:00Z", "truth": "false"},
    {"name": "the instant, not its spelling: 02:30 at -05:00 is 08:30 at +01:00", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-06T02:30:00-05:00", "truth": "true"},
    {"name": "the instant, not its spelling: 08:30 at +08:00 is 01:30 at +01:00", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-06T08:30:00+08:00", "truth": "false"},
    {"name": "spelled in the guard's own offset, a second before from", "window": {"at": "t", "days": ["mon", "tue", "wed", "thu"], "from": "08:00", "to": "16:00", "offset": "+01:00"}, "t": "2020-01-06T07:59:59+01:00", "truth": "false"},
    {"name": "the local day starts before the UTC day", "window": {"at": "t", "days": ["mon"], "from": "00:00", "to": "24:00", "offset": "+01:00"}, "t": "2020-01-05T23:00:00Z", "truth": "true"},
    {"name": "a second before the local day", "window": {"at": "t", "days": ["mon"], "from": "00:00", "to": "24:00", "offset": "+01:00"}, "t": "2020-01-05T22:59:59Z", "truth": "false"},
    {"name": "the last second of the local day", "window": {"at": "t", "days": ["mon"], "from": "00:00", "to": "24:00", "offset": "+01:00"}, "t": "2020-01-06T22:59:59Z", "truth": "true"},
    {"name": "the next local day", "window": {"at": "t", "days": ["mon"], "from": "00:00", "to": "24:00", "offset": "+01:00"}, "t": "2020-01-06T23:00:00Z", "truth": "false"},
    {"name": "one instant, two offsets: Friday at +01:00", "window": {"at": "t", "days": ["fri"], "from": "00:00", "to": "24:00", "offset": "+01:00"}, "t": "2020-01-09T23:30:00Z", "truth": "true"},
    {"name": "one instant, two offsets: Thursday at Z", "window": {"at": "t", "days": ["fri"], "from": "00:00", "to": "24:00", "offset": "Z"}, "t": "2020-01-09T23:30:00Z", "truth": "false"},
    {"name": "one instant, two offsets: Thursday at -05:00", "window": {"at": "t", "days": ["thu"], "from": "00:00", "to": "24:00", "offset": "-05:00"}, "t": "2020-01-09T23:30:00Z", "truth": "true"},
    {"name": "crossing midnight: a second before from", "window": {"at": "t", "days": ["fri"], "from": "22:00", "to": "02:00", "offset": "Z"}, "t": "2020-01-10T21:59:59Z", "truth": "false"},
    {"name": "crossing midnight: from on the listed day", "window": {"at": "t", "days": ["fri"], "from": "22:00", "to": "02:00", "offset": "Z"}, "t": "2020-01-10T22:00:00Z", "truth": "true"},
    {"name": "crossing midnight: after midnight belongs to the day it opened", "window": {"at": "t", "days": ["fri"], "from": "22:00", "to": "02:00", "offset": "Z"}, "t": "2020-01-11T01:59:59Z", "truth": "true"},
    {"name": "crossing midnight: to is exclusive on the next day", "window": {"at": "t", "days": ["fri"], "from": "22:00", "to": "02:00", "offset": "Z"}, "t": "2020-01-11T02:00:00Z", "truth": "false"},
    {"name": "crossing midnight: the listed day's own early hours belong to the day before", "window": {"at": "t", "days": ["fri"], "from": "22:00", "to": "02:00", "offset": "Z"}, "t": "2020-01-10T01:00:00Z", "truth": "false"},
    {"name": "crossing midnight: the next day's evening is not listed", "window": {"at": "t", "days": ["fri"], "from": "22:00", "to": "02:00", "offset": "Z"}, "t": "2020-01-11T22:30:00Z", "truth": "false"},
    {"name": "crossing midnight at an offset: Sunday 23:00 at +05:30", "window": {"at": "t", "days": ["sun"], "from": "23:00", "to": "01:00", "offset": "+05:30"}, "t": "2020-01-12T17:30:00Z", "truth": "true"},
    {"name": "crossing midnight at an offset: Monday 00:59:59 belongs to Sunday", "window": {"at": "t", "days": ["sun"], "from": "23:00", "to": "01:00", "offset": "+05:30"}, "t": "2020-01-12T19:29:59Z", "truth": "true"},
    {"name": "crossing midnight at an offset: Monday 01:00 is outside", "window": {"at": "t", "days": ["sun"], "from": "23:00", "to": "01:00", "offset": "+05:30"}, "t": "2020-01-12T19:30:00Z", "truth": "false"},
    {"name": "crossing midnight at an offset: Tuesday 00:30 follows an unlisted Monday", "window": {"at": "t", "days": ["sun"], "from": "23:00", "to": "01:00", "offset": "+05:30"}, "t": "2020-01-06T19:00:00Z", "truth": "false"},
    {"name": "to 24:00: the last second of Saturday at -03:00", "window": {"at": "t", "days": ["sat", "sun"], "from": "18:00", "to": "24:00", "offset": "-03:00"}, "t": "2020-01-12T02:59:59Z", "truth": "true"},
    {"name": "to 24:00: Sunday 00:00 is before from", "window": {"at": "t", "days": ["sat", "sun"], "from": "18:00", "to": "24:00", "offset": "-03:00"}, "t": "2020-01-12T03:00:00Z", "truth": "false"},
    {"name": "to 24:00: a second before from", "window": {"at": "t", "days": ["sat", "sun"], "from": "18:00", "to": "24:00", "offset": "-03:00"}, "t": "2020-01-11T20:59:59Z", "truth": "false"},
    {"name": "to 24:00: from", "window": {"at": "t", "days": ["sat", "sun"], "from": "18:00", "to": "24:00", "offset": "-03:00"}, "t": "2020-01-11T21:00:00Z", "truth": "true"},
    {"name": "the largest offset east", "window": {"at": "t", "days": ["mon"], "from": "00:00", "to": "01:00", "offset": "+14:00"}, "t": "2020-01-05T10:00:00Z", "truth": "true"},
    {"name": "the largest offset west", "window": {"at": "t", "days": ["sun"], "from": "23:00", "to": "24:00", "offset": "-14:00"}, "t": "2020-01-13T13:30:00Z", "truth": "true"},
    {"name": "before the epoch", "window": {"at": "t", "days": ["wed"], "from": "00:00", "to": "24:00", "offset": "Z"}, "t": "1969-12-31T12:00:00Z", "truth": "true"},
    {"name": "an unobserved instant is unknown", "window": {"at": "t", "days": ["mon"], "from": "08:00", "to": "16:00", "offset": "Z"}, "t": null, "truth": "unknown"},
    {"name": "text that is no instant is unknown", "window": {"at": "t", "days": ["mon"], "from": "08:00", "to": "16:00", "offset": "Z"}, "t": "Monday 09:00", "truth": "unknown"},
    {"name": "a date alone is no instant", "window": {"at": "t", "days": ["mon"], "from": "00:00", "to": "24:00", "offset": "Z"}, "t": "2020-01-06", "truth": "unknown"},
    {"name": "a number is no instant", "window": {"at": "t", "days": ["mon"], "from": "00:00", "to": "24:00", "offset": "Z"}, "t": 1578268800, "truth": "unknown"}
  ],
