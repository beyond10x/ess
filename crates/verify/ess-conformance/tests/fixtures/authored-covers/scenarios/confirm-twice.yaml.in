type: ess-scenario/7
covers:
  - example.review.ConfirmDecision/outcome/already-exists
domain: example.review
scenario: confirm-decision-already-exists
summary: A confirmation sent twice for one identity takes already-exists the second time.

timeline:
  - at: 2026-01-05T09:00:00Z
    command: example.review.RecordDecision
    actor: example.review.Reviewer
    input: {decision_id: old, item: a}
    outcome: recorded
  - at: 2026-01-05T09:00:01Z
    command: example.review.ExpireDecision
    actor: example.review.Reviewer
    input: {decision_id: old}
    outcome: expired
  - at: 2026-01-05T09:00:02Z
    command: example.review.ConfirmDecision
    actor: example.review.Reviewer
    input: {decision_id: new, confirms: old, item: a}
    outcome: confirmed
  - at: 2026-01-05T09:00:03Z
    command: example.review.ConfirmDecision
    actor: example.review.Reviewer
    input: {decision_id: new, confirms: old, item: b}
    outcome: already-exists
