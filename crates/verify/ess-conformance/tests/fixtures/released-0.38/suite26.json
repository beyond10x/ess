  "scenarios": {
    "demo.notes.RewordNote/outcome/reworded": {
      "purpose": "`demo.notes.RewordNote` answers `reworded` for an input no other branch's guard claims",
      "steps": [
        {
          "step": "execute_command",
          "command": "demo.notes.SubmitNote",
          "actor": "demo.notes.Service",
          "input": {
            "text": {
              "kind": "literal",
              "value": "text"
            }
          }
        },
        {
          "step": "expect_outcome",
          "outcome": {
            "command": "demo.notes.SubmitNote",
            "outcome": "submitted"
          }
        },
        {
          "step": "capture_instance",
          "instance": "note",
          "entity": "demo.notes.Note",
          "event": "demo.notes.NoteSubmitted",
          "field": "note_id"
        },
        {
          "step": "execute_command",
          "command": "demo.notes.RewordNote",
          "actor": "demo.notes.Service",
          "input": {
            "note_id": {
              "kind": "instance",
              "instance": "note"
            },
            "text": {
              "kind": "literal",
              "value": "text-1"
            }
          }
        },
        {
          "step": "expect_outcome",
          "outcome": {
            "command": "demo.notes.RewordNote",
            "outcome": "reworded"
          }
        },
        {
          "step": "expect_event",
          "event": "demo.notes.NoteReworded",
          "shape": {
            "note_id": {
              "holds": "primitive",
              "kind": "uuid"
            }
          }
        },
        {
          "step": "expect_no_event",
          "event": "demo.notes.NoteSubmitted"
        },
        {
          "step": "query_view",
          "view": "demo.notes.NoteDetails"
        },
        {
          "step": "expect_view",
          "view": "demo.notes.NoteDetails",
          "expectation": {
            "expect": "contains",
            "fields": {
              "note_id": {
                "kind": "instance",
                "instance": "note"
              }
            }
          }
        }
      ],
      "source": [
        {
          "kind": "type",
          "name": "demo.notes.NoteId"
        },
