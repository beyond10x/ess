+
+fn residual_field(field: &mut serde_json::Value) {
+    remove_keys(field, &["name", "type_ref"]);
+    if let Some(naming) = field.get_mut("naming") {
+        remove_keys(naming, &["wire", "display", "summary"]);
+    }
