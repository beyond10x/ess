      "title": "AccountId",
      "x-ess-name": "billing.invoice.AccountId",
      "x-ess-kind": "newtype",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "billing.invoice.Channel": {
      "title": "Delivery channel",
      "x-ess-name": "billing.invoice.Channel",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Email",
        "Post",
        "Portal"
      ]
    },
    "billing.invoice.CompanyRef": {
      "title": "CompanyRef",
      "x-ess-name": "billing.invoice.CompanyRef",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "billing.invoice.Email": {
      "title": "Email",
      "x-ess-name": "billing.invoice.Email",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "billing.invoice.Invoice.State": {
      "title": "State",
      "x-ess-name": "billing.invoice.Invoice.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Cancelled",
        "Draft",
        "Issued",
        "Paid"
      ]
    },
    "billing.invoice.InvoiceId": {
      "title": "InvoiceId",
      "x-ess-name": "billing.invoice.InvoiceId",
      "x-ess-kind": "newtype",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "billing.invoice.LineItem": {
      "title": "LineItem",
      "x-ess-name": "billing.invoice.LineItem",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        },
        "unit_price": {
          "$ref": "#/$defs/billing.invoice.Money"
        }
      },
      "required": [
        "description",
        "quantity",
        "unit_price"
      ],
      "additionalProperties": false
    },
    "billing.invoice.Money": {
      "title": "Money",
      "x-ess-name": "billing.invoice.Money",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "amount >= 0"
      ]
    },
    "billing.invoice.Payee": {
      "title": "Payee",
      "x-ess-name": "billing.invoice.Payee",
      "x-ess-kind": "union",
      "oneOf": [
        {
          "title": "company",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "company"
            },
            "value": {
              "$ref": "#/$defs/billing.invoice.CompanyRef"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "title": "person",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "person"
            },
            "value": {
              "$ref": "#/$defs/billing.invoice.Email"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "x-ess-union-tag": "kind"
    }
  }
