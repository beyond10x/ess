{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice",
  "x-ess-name": "billing.invoice.Invoice",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "invoice_id": {
      "$ref": "#/$defs/billing.invoice.InvoiceId"
    },
    "account_id": {
      "$ref": "#/$defs/billing.invoice.AccountId",
      "x-ess-relation": {
        "name": "invoices",
        "kind": "owns",
        "source": "billing.invoice.Account",
        "target": "billing.invoice.Invoice",
        "cardinality": "many",
        "via": "account_id"
      }
    },
    "total": {
      "$ref": "#/$defs/billing.invoice.Money"
    },
    "payee": {
      "$ref": "#/$defs/billing.invoice.Payee"
    },
    "channel": {
      "$ref": "#/$defs/billing.invoice.Channel"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/billing.invoice.LineItem"
      }
    },
    "note": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-ess-map-key": "String"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "settlement_window": {
      "type": "string",
      "format": "duration"
    },
    "is_recurring": {
      "type": "boolean"
    },
    "signature": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64"
    },
    "state": {
      "$ref": "#/$defs/billing.invoice.Invoice.State"
    }
  },
  "required": [
    "invoice_id",
    "account_id",
    "total",
    "payee",
    "channel",
    "lines",
    "metadata",
    "settlement_window",
    "is_recurring",
    "signature",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "billing",
    "specification_version": "v3",
    "source_digest": "aacdc2fe065d462cc4f9ba51e6740f88809b6b17ce006ef846b488f957005da3",
    "contract_digest": "32aef9c9341397b0d6575a3cb9574369a7c8cb5337a3b68ba98675d0d26fa316",
    "regenerate": "ess generate"
