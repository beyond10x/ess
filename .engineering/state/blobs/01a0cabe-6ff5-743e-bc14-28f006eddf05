mutable review package.\n\n## Machine-readable findings\n\n```yaml\nfindings: []\nverdict: approve\nscope: source-and-claim-acceptance-only\nauthority_effect: NONE\nqualified_production_pairs: 0\nrows_examined: 4474\nexact_supported_claims: 3692\nexplicit_non_authority_categories:\n  existing_gaps: 64\n  aggregate_candidates: 20\n  graph_boundary_candidates: 33\n  cli_target_limitations: 594\n  absent_scenario_step_tuples: 71\nfeasible_unproved: 0\n```\n","relations":[{"reviews":"task:consumer-accounting-cli-coverage"}],"status":"active","title":"CLI coverage final source and claim review, pass 2"},"lifecycle_state":"active"}},"id":"MIG6e724cf286c863f000bb1d54796134b65fc8c7fbbe54078e0b3877d5167cb66b","lifecycle_state":"recorded","revision":1,"version":1},"order":"per_kind_only","subject":["aep.entity","MIG6e724cf286c863f000bb1d54796134b65fc8c7fbbe54078e0b3877d5167cb66b"]}]