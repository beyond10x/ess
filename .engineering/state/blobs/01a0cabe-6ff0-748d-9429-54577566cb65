["er.eventlog.import-anchor/1",{"authority":{"logical_scope":"ess","stream_identity":"01a0cabe-67c1-7103-8e43-bb0ee2ca8073","tenant":"planning"},"completeness":"available_evidence_only","evidence":[],"instance":{"entity":"aep.entity","fields":{"document":{"events":[],"fields":{"$aep":{"archived":false,"metadata":{"created_at":0,"id":"MIG46dd193fb823f5b4e326d52e7b18c1590fc3fbedf550b4332b9ff89eb15edd8e","locator":"ep://planning/store/story/oci-component-release","provenance":{"created_by":"system","updated_by":"system"},"revision":7,"type":"aep.story/v1","updated_at":0}},"body":"# Story: Execute and compose OCI component releases\n\n## Outcome\n\nA repository-owned ESS component descriptor can be built standalone, published as a verified OCI bundle, hydrated into a release catalogue, and reconciled as one independent Helm release.\n\n## Acceptance\n\n- ESS validates and compiles component descriptors over existing semantic, realization, build, runtime, and release formats.\n- Runtime models provided endpoints, named persistent volumes, and explicit mounts; Helm projection emits Services, claims, mounts, and workload-safe selectors.\n- OCI publication and fetch are explicit credential-edge operations, idempotent by immutable digest, and admit only revalidated canonical bundle bytes to the cache.\n- Stack compilation derives named internal or external endpoint bindings.\n- Deployment reconciliation applies only changed releases in rollout order and refuses cross-cluster transitions or implicit removals.\n","relations":[{"decomposes":"epic:oci-component-delivery"}],"scope":[{"confidence":"cited","path":"CHANGELOG.md"},{"confidence":"cited","path":"Cargo.lock"},{"confidence":"cited","path":"Cargo.toml"},{"confidence":"cited","path":"README.md"},{"confidence":"cited","path":"crates/edge/ess-cli"},{"confidence":"cited","path":"crates/generate/ess-deployment"},{"confidence":"cited","path":"website/docs"}],"status":"implemented","summary":"Make independently released component bundles the reusable ESS deployment unit.","title":"Execute and compose OCI component releases"},"lifecycle_state":"implemented"}},"id":"MIG46dd193fb823f5b4e326d52e7b18c1590fc3fbedf550b4332b9ff89eb15edd8e","lifecycle_state":"recorded","revision":7,"version":1},"order":"per_kind_only","subject":["aep.entity","MIG46dd193fb823f5b4e326d52e7b18c1590fc3fbedf550b4332b9ff89eb15edd8e"]}]