ine was relaxed. See docs/conformance-core-checkpoint-2026-09-21.md and https://github.com/beyond10x/ess/actions/runs/35639713420.\n","relations":[{"decomposes":"epic:model-driven-interpretation"},{"serves":"vision:O2"}],"scope":[{"confidence":"cited","path":"CHANGELOG.md"},{"confidence":"cited","path":"crates/edge/ess-xtask"},{"confidence":"cited","path":"crates/generate"},{"confidence":"cited","path":"crates/specify/ess-compiler"},{"confidence":"cited","path":"crates/specify/ess-domain"},{"confidence":"cited","path":"crates/verify/ess-conformance"},{"confidence":"cited","path":"docs/design"},{"confidence":"cited","path":"models/toolchain"},{"confidence":"cited","path":"schemas/generated"},{"confidence":"cited","path":"website/docs/reference"}],"status":"implemented","title":"A command can observe a subject fact and complete without a change"},"lifecycle_state":"implemented"},"relations":[{"decomposes":"epic:model-driven-interpretation"},{"serves":"vision:O2"}],"scope":[{"confidence":"cited","path":"CHANGELOG.md"},{"confidence":"cited","path":"crates/edge/ess-xtask"},{"confidence":"cited","path":"crates/generate"},{"confidence":"cited","path":"crates/specify/ess-compiler"},{"confidence":"cited","path":"crates/specify/ess-domain"},{"confidence":"cited","path":"crates/verify/ess-conformance"},{"confidence":"cited","path":"docs/design"},{"confidence":"cited","path":"models/toolchain"},{"confidence":"cited","path":"schemas/generated"},{"confidence":"cited","path":"website/docs/reference"}],"title":"A command can observe a subject fact and complete without a change"},"id":"ent-0da61c7ad82cd8ae8f7344e57e609ee9","lifecycle_state":"implemented","revision":15,"version":1},"order":"per_kind_only","subject":["story","ent-0da61c7ad82cd8ae8f7344e57e609ee9"]}]