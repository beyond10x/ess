["er.request/1",{"definition_version":1,"fields":{"document":{"events":[],"fields":{"intent":{"causation":null,"command_id":"cmd-child-020304a7ec08980bcaa379ca4ef2d6a5c93578513ae017fd50f20c0345eab078","command_type":"aep.entity.create/v1","correlation_id":"protocol-artifact-new","execution_id":null,"expected_revision":null,"payload":{"command":"create-entity","data":{"body":"# Story: a concurrent history has a format\n\n## Outcome\n\n`ess-history/1` records a concurrent run: the `spec_digest`, the seed, the client count, and per\noperation its client, command, subject identity, invoke instant, return instant and outcome. An\noperation with no answer is `Indeterminate`, and its return instant is read as \"after every other\noperation\" (the S2 rule, https://s2.dev/blog/linearizability). Go and TypeScript runners write it;\nthe Rust checker reads it. The document is the one `models/concurrent-history/` declares.\n\n## Acceptance\n\n- A history written by the Go runner and one written by the TypeScript runner from the same seed\n  over `examples/billing` are equal bytes.\n- A history whose `spec_digest` differs from the compiled IR is refused with a named diagnostic\n  before any check runs.\n- An operation marked `Returned` with no return instant is refused by name.\n- An operation whose return instant precedes its invoke instant is refused by name.\n\n## Scope\n\nNew format module in `ess-conformance`, its JSON Schema under `schemas/`, the Go and TS writers.\n","owner":"ess","status":"draft","title":"A concurrent history has a format: ess-history/1"},"entity_type":"aep.story/v1","locator":"ep://planning/store/story/concurrent-history-format"},"target":null,"task":null},"result":{"affected":["ent-7cd9a75836780aca2cd3a13599b802af@1"],"audit":["aud-1f9a2a2eb7465546063601ae35b5f8f5"],"command_id":"cmd-child-020304a7ec08980bcaa379ca4ef2d6a5c93578513ae017fd50f20c0345eab078","consistency":"seq-000000000000","events":["evt-1f9a292eb74653930635feae35b5f3dc"],"outcome":"accepted"}},"lifecycle_state":"recorded"}},"kind":"create","recording":{"actor":"human:timo","causation":"cmd-child-020304a7ec08980bcaa379ca4ef2d6a5c93578513ae017fd50f20c0345eab078","correlation":"protocol-artifact-new","record_id":"aep.applied:child-020304a7ec08980bcaa379ca4ef2d6a5c93578513ae017fd50f20c0345eab078@1~58f7600ee59ba514","recorded_at":"2026-09-27T11:25:02Z"},"subject":["aep.applied","child-020304a7ec08980bcaa379ca4ef2d6a5c93578513ae017fd50f20c0345eab078"]}]