n    /// Delivers until quiescent: collects every component's outbox onto the log, then delivers\\n    /// each logged event to every binding that reacts to it — at least once each, which is the\\n    /// guarantee the specification declares.\\n    ///\\n    /// `Err` carries the first unmet obligation that delivery could not route around; the log\\n    /// keeps everything already published. A specification whose bindings feed each other\\n    /// without end will not quiesce, and this pump will not pretend otherwise.\\n    pub fn pump(&mut self) -> Result<(), demo_types::obligation::UnmetObligation> {\\n        loop {\\n            self.collect();\\n            if self.cursor == self.published.len() {\\n                return Ok(());\\n            }\\n            self.cursor += 1;\\n        }\\n    }\\n\\n    /// Moves every component's outbox onto the log, in component order.\\n    fn collect(&mut self) {\\n        for event in self.worker.drain_outbox() {\\n            self.published.push(SystemEvent::from(event));\\n        }\\n    }\\n}\\n\",\n    \"slice\": {\n      \"of\": \"whole-model\"\n    }\n  },\n  \"crates/demo-types/Cargo.toml\": {\n    \"path\": \"crates/demo-types/Cargo.toml\",\n    \"contents\": \"# generated from demo v1\\n# model digest 57d2eb2785ad2fb21ed2085027df2fe64d2c13ba96a7c2c117fa9ceb3a33bcb3\\n# contract digest b13ddd0f4c243fbcbbce4d83a7b63a61419f752c65caa827b15acc1b3a3c99df\\n# do not edit: regenerate with `ess synthesize`\\n\\n[package]\\nname = \\\"demo-types\\\"\\ndescription = \\\"Semantic types synthesised from the `demo` specification, v1.\\\"\\nversion = \\\"1.0.0\\\"\\nedition = \\\"2021\\\"\\n\\n[dependencies]\\n\",\n    \"slice\": {\n      \"of\": \"whole-model\"\n    }\n  },\n  \"crates/demo-types/src/core.rs\": {\n    \"path\": \"crates/demo-types/src/core.rs\",\n    \"contents\": \"// generated from demo v1\\n// model digest 57d2eb2785ad2fb21ed2085027df2fe64d2c13ba96a7c2c117fa9ceb3a33bcb3\\n// contract digest b13ddd0f4c243