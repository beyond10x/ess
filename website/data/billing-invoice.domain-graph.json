{
  "format": "b10x-domain-graph/1",
  "domain": {
    "id": "billing.invoice",
    "display": "Invoicing",
    "summary": "Issuing invoices and tracking whether they are paid.",
    "system": "billing",
    "source": "examples/billing, compiled by `ess specify compile`; generated by `cargo xtask site-data`"
  },
  "entities": [
    {
      "id": "billing.invoice.Account",
      "name": "Account",
      "identity": {
        "name": "account_id",
        "type": "AccountId"
      },
      "fields": [
        {
          "name": "display_name",
          "type": "string"
        }
      ],
      "lifecycle": {
        "initial": "Active",
        "states": [
          "Active"
        ],
        "terminal": [
          "Active"
        ]
      }
    },
    {
      "id": "billing.invoice.Invoice",
      "name": "Invoice",
      "identity": {
        "name": "invoice_id",
        "type": "InvoiceId"
      },
      "fields": [
        {
          "name": "account_id",
          "type": "AccountId"
        },
        {
          "name": "total",
          "type": "Money"
        },
        {
          "name": "payee",
          "type": "Payee"
        },
        {
          "name": "channel",
          "type": "Channel"
        },
        {
          "name": "lines",
          "type": "List<LineItem>"
        },
        {
          "name": "note",
          "type": "Optional<string>"
        },
        {
          "name": "metadata",
          "type": "Map<string, string>"
        },
        {
          "name": "issued_at",
          "type": "Optional<timestamp>"
        },
        {
          "name": "settlement_window",
          "type": "duration"
        },
        {
          "name": "is_recurring",
          "type": "boolean"
        },
        {
          "name": "signature",
          "type": "bytes"
        },
        {
          "name": "reminder_count",
          "type": "integer"
        }
      ],
      "createdBy": [
        "billing.invoice.CreateInvoice"
      ],
      "lifecycle": {
        "initial": "Draft",
        "states": [
          "Cancelled",
          "Draft",
          "Issued",
          "Paid"
        ],
        "terminal": [
          "Cancelled",
          "Paid"
        ],
        "transitions": [
          {
            "name": "issue",
            "from": [
              "Draft"
            ],
            "to": "Issued",
            "commands": [
              "billing.invoice.IssueInvoice"
            ]
          },
          {
            "name": "settle",
            "from": [
              "Issued"
            ],
            "to": "Paid",
            "commands": [
              "billing.invoice.PayInvoice"
            ]
          },
          {
            "name": "cancel",
            "from": [
              "Draft",
              "Issued"
            ],
            "to": "Cancelled",
            "commands": [
              "billing.invoice.CancelInvoice"
            ]
          }
        ]
      }
    }
  ],
  "relations": [
    {
      "from": "billing.invoice.Account",
      "to": "billing.invoice.Invoice",
      "name": "invoices",
      "kind": "owns",
      "cardinality": "many",
      "via": "account_id"
    }
  ]
}
